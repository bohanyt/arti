{ "v": "arti.refusals/1", "default": "defect-unclassified",
  "codes": {
    "game_refusal":            { "class": "game", "precondition": "game_refusals.json entry for native_code; its fact_check holds in the admission snapshot or result witnesses, else refusal_fact_mismatch",
                                 "single": { "bucket": "outcome-game" },
                                 "rates": [ { "scope": "code_target", "n": 5, "window_s": 600, "bucket": "defect-sensing" },
                                            { "scope": "code", "n": 10, "window_s": 600, "bucket": "defect-sensing", "one_per_window": true } ] },
    "debt_active":             { "class": "own_debt", "class_by": "debt.opened_by", "precondition": "debt_id present in the snapshot debts",
                                 "single": { "bucket": "info" },
                                 "rates": [ { "scope": "debt_age", "n": 1, "window_s": 10, "bucket": "defect-own-fence" },
                                            { "scope": "target_e0", "n": 3, "window_s": 60, "bucket": "defect-own-fence" },
                                            { "scope": "class", "n": 10, "window_s": 300, "bucket": "defect-own-fence" } ] },
    "premotor_busy":           { "class": "own_debt", "precondition": "native active_attempt non-null at admission",
                                 "single": { "bucket": "info" },
                                 "rates": [ { "scope": "target_e0", "n": 3, "window_s": 60, "bucket": "defect-own-fence" },
                                            { "scope": "class", "n": 10, "window_s": 300, "bucket": "defect-own-fence" } ] },
    "backend_undeliverable":   { "class": "backend", "precondition": "native code", "single": { "bucket": "info" },
                                 "rates": [ { "scope": "class", "n": 5, "window_s": 300, "bucket": "defect-motor", "one_per_window": true } ] },
    "interrupted_before_edge": { "class": "backend", "precondition": "native code N0_NOT_CONSUMED", "single": { "bucket": "info" },
                                 "rates": [ { "scope": "class", "n": 5, "window_s": 300, "bucket": "defect-motor", "one_per_window": true } ] },
    "latch_unreachable":       { "class": "backend", "precondition": "native code LATCH_NOT_OWNED", "single": { "bucket": "info" },
                                 "rates": [ { "scope": "class", "n": 5, "window_s": 300, "bucket": "defect-motor", "one_per_window": true } ] },
    "focus_lost":              { "class": "backend", "precondition": "IInputBackend.Lost fired", "single": { "bucket": "info" },
                                 "rates": [ { "scope": "class", "n": 5, "window_s": 300, "bucket": "defect-motor", "one_per_window": true } ] },
    "seat_unavailable":        { "class": "backend", "precondition": "input seat not installable this tick", "single": { "bucket": "info" },
                                 "rates": [ { "scope": "class", "n": 5, "window_s": 300, "bucket": "defect-motor", "one_per_window": true } ] },
    "not_admitted_deadline":   { "class": "backend", "precondition": "withdrawal receipt after the 1,000 ms admission bound", "single": { "bucket": "info" },
                                 "rates": [ { "scope": "class", "n": 5, "window_s": 300, "bucket": "defect-motor", "one_per_window": true } ] },
    "offer_stale":             { "class": "staleness", "precondition": "fresh-snapshot diff names the changed field", "single": { "bucket": "info" },
                                 "rates": [ { "scope": "class", "n": 10, "window_s": 300, "bucket": "defect-sensing" } ] },
    "binding_changed":         { "class": "staleness", "precondition": "fresh-snapshot diff names the changed field", "single": { "bucket": "info" },
                                 "rates": [ { "scope": "class", "n": 10, "window_s": 300, "bucket": "defect-sensing" } ] },
    "precondition_stale":      { "class": "staleness", "precondition": "fresh-snapshot diff names the changed field", "single": { "bucket": "info" },
                                 "rates": [ { "scope": "class", "n": 10, "window_s": 300, "bucket": "defect-sensing" } ] },
    "authority_not_core":      { "class": "authority", "precondition": "ui.authority.holder != core",
                                 "single": { "bucket": "info", "if_fact": "handoff_within_2s", "else_bucket": "defect-lost-decision" }, "rates": [] },
    "authority_busy":          { "class": "authority", "precondition": "progression attempt active on the epoch",
                                 "single": { "bucket": "info", "if_fact": "handoff_within_2s", "else_bucket": "defect-lost-decision" }, "rates": [] },
    "claim_stale_epoch":       { "class": "authority", "precondition": "claim epoch != current top epoch", "single": { "bucket": "info" }, "rates": [] },
    "generation_fenced":       { "class": "authority", "precondition": "request generation <= session.fenced_generation",
                                 "single": { "bucket": "info", "if_fact": "after_restart_fence", "else_bucket": "defect-lifecycle" }, "rates": [] },
    "lease_expired":           { "class": "authority", "precondition": "native LeaseExpired",
                                 "single": { "bucket": "info", "if_fact": "cancel_or_preadmission_deadline", "else_bucket": "defect-lifecycle" },
                                 "rates": [ { "scope": "code", "n": 5, "window_s": 600, "bucket": "defect-lifecycle", "filter": "lease_expired|stale_control_seq" } ] },
    "stale_control_seq":       { "class": "authority", "precondition": "native StaleControlSeq",
                                 "single": { "bucket": "info", "if_fact": "cancel_or_preadmission_deadline", "else_bucket": "defect-lifecycle" },
                                 "rates": [ { "scope": "code", "n": 5, "window_s": 600, "bucket": "defect-lifecycle", "filter": "lease_expired|stale_control_seq" } ] },
    "journal_uncertain":       { "class": "authority", "precondition": "native journal row Uncertain/Compacted/IdentityMismatch/SequenceConflict/PersistenceFault",
                                 "single": { "bucket": "defect-effect-integrity" }, "rates": [] },
    "journal_capacity":        { "class": "authority", "precondition": "native.journal.unresolved >= cap or session capacity",
                                 "single": { "bucket": "defect-effect-integrity" }, "rates": [] },
    "stop_latched":            { "class": "halt", "precondition": "session.halt non-null at the refusal",
                                 "single": { "bucket": "info", "if_fact": "core_observed_halt", "else_bucket": "defect-lifecycle" },
                                 "rates": [ { "scope": "acquire_after_halt", "n": 1, "window_s": 0, "bucket": "defect-lifecycle" } ] },
    "adapter_unimplemented":   { "class": "adapter", "precondition": "-", "single": { "bucket": "defect-adapter" }, "rates": [] },
    "adapter_unmapped_form":   { "class": "adapter", "precondition": "-", "single": { "bucket": "defect-adapter" }, "rates": [] },
    "adapter_unsupported_capability": { "class": "adapter", "precondition": "-", "single": { "bucket": "defect-adapter" }, "rates": [] },
    "adapter_malformed":       { "class": "adapter", "precondition": "-", "single": { "bucket": "defect-adapter" }, "rates": [] },
    "not_published":           { "class": "abort", "precondition": "attempt record state recorded + no link, or attempt_status Fresh after fence",
                                 "single": { "bucket": "info" },
                                 "rates": [ { "scope": "cause", "n": 5, "window_s": 600, "bucket": "defect-lifecycle" },
                                            { "scope": "activity_consecutive", "n": 3, "window_s": 0, "bucket": "defect-lifecycle" } ] },
    "withdrawn":               { "class": "abort", "precondition": "unlink receipt", "single": { "bucket": "info" },
                                 "rates": [ { "scope": "cause", "n": 5, "window_s": 600, "bucket": "defect-lifecycle" },
                                            { "scope": "activity_consecutive", "n": 3, "window_s": 0, "bucket": "defect-lifecycle" } ] },
    "stopped":                 { "class": "control", "precondition": "operator/owner STOP record", "single": { "bucket": "outcome-game" }, "rates": [] },
    "identity":                { "class": "control", "precondition": "save/player/session/runtime/owner mismatch fact", "single": { "bucket": "hazard" }, "rates": [] },
    "cancelled":               { "class": "control", "precondition": "control record carrying cancel_reason", "single": { "bucket": "info" },
                                 "rates": [ { "scope": "no_completed_between", "n": 5, "window_s": 600, "bucket": "defect-lifecycle", "filter": "cancel_reason=supersede" },
                                            { "scope": "no_completed_between", "n": 10, "window_s": 600, "bucket": "defect-lifecycle", "filter": "cancel_reason=interrupt" } ] },
    "refusal_fact_mismatch":   { "class": "integrity", "precondition": "declared code present, its fact check false, absent or unreadable (R0-06 AP-42)", "single": { "bucket": "defect-sensing" }, "rates": [] }
  },
  "cancel_reasons": {
    "hazard":     { "bucket": "cited_hazard", "requires_citation": "hazard_record" },
    "owner_stop": { "bucket": "outcome-game" },
    "interrupt":  { "bucket": "info", "requires_citation": "arriving_receiver_id" },
    "supersede":  { "bucket": "info" },
    "deadline":   { "bucket": "defect-lifecycle" },
    "shutdown":   { "bucket": "info" }
  },
  "native_map": {
    "MalformedJson": "adapter_malformed", "UnsupportedProtocol": "adapter_malformed", "MissingRequestId": "adapter_malformed",
    "InvalidDirection": "adapter_malformed", "InvalidTimeout": "adapter_malformed", "InvalidDelay": "adapter_malformed",
    "InvalidTile": "adapter_malformed", "InvalidTickCount": "adapter_malformed", "InvalidRadius": "adapter_malformed",
    "ResultTooLarge": "adapter_malformed", "ControlRecordFault": "adapter_malformed",
    "UnsupportedOp": "adapter_unimplemented", "InboxDisabled": "adapter_unsupported_capability",
    "DuplicateRequestId": "not_a_refusal", "JournalDuplicateSettled": "not_a_refusal",
    "CommandBusy": "premotor_busy",
    "CommandSessionCapacityReached": "journal_capacity", "JournalCapacityReached": "journal_capacity",
    "SessionMismatch": "identity", "PlayerMismatch": "identity", "OwnerMismatch": "identity", "RuntimeMismatch": "identity",
    "GenerationMismatch": "generation_fenced",
    "LocationMismatch": "precondition_stale", "ScreenMismatch": "precondition_stale", "BindingMismatch": "binding_changed",
    "Expired": "not_admitted_deadline", "StopLatched": "stop_latched", "LeaseExpired": "lease_expired",
    "StaleControlSeq": "stale_control_seq", "ArmRejected": "backend_undeliverable",
    "JournalUncertain": "journal_uncertain", "JournalSettledCompacted": "journal_uncertain",
    "JournalIdentityMismatch": "journal_uncertain", "JournalSequenceConflict": "journal_uncertain",
    "JournalPersistenceFault": "journal_uncertain",
    "N0_NOT_CONSUMED": "interrupted_before_edge", "LATCH_NOT_OWNED": "latch_unreachable",
    "HOOK_INSTALL_UNCONFIRMED": "seat_unavailable", "LATCH_INSTALL_UNCONFIRMED": "seat_unavailable",
    "GAME_FIELD_ACCESS_UNAVAILABLE": "backend_undeliverable"
  }
}
