{ "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "arti:contracts/successors.schema.json",
  "type": "object", "additionalProperties": false, "required": ["v", "rows"],
  "properties": { "v": { "const": "arti.successors/1" },
    "rows": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false,
      "required": ["key", "answer_class", "legal_successors"],
      "properties": {
        "key": { "type": "object", "additionalProperties": false, "required": ["receiver_class", "control_role", "gesture"],
                 "properties": { "receiver_class": { "type": "string", "maxLength": 96 },
                                 "control_role": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
                                 "gesture": { "enum": ["press_a", "press_b", "secondary", "scroll", "type", "close", "advance",
                                                       "open_menu", "world_edge"] } } },
        "callback_class": { "enum": ["sleep", "eat", "event_question", "unknown_callback"] },
        "answer_class": { "enum": ["terminal", "transaction", "navigation", "edit"] },
        "post_answer": { "enum": ["outro"] },
        "legal_successors": { "type": "array", "maxItems": 8, "items": { "type": "object", "additionalProperties": false,
          "required": ["edge", "receiver_class"],
          "properties": { "edge": { "enum": ["closed", "replaced", "opened"] },
                          "receiver_class": { "type": "string", "maxLength": 96, "$comment": "\"hud\" for closed→HUD" },
                          "question_key": { "type": "string", "maxLength": 64 },
                          "via": { "enum": ["edge", "continuation"] } } } } } } } } }
