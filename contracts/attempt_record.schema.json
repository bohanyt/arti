{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arti:contracts/attempt_record.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["v", "attempt_id", "request_id", "request_seq", "runtime_id", "session_id", "owner_id", "generation",
               "payload_sha256", "verb", "args", "pins", "before", "activity_id", "decision_id", "occurrence_no",
               "offer_generation", "actor", "admission_class", "row_key", "possible_delta", "fence_keys", "released_ms", "state",
               "created_ms"],
  "properties": {
    "v": { "const": "arti.attempt_record/1" },
    "attempt_id": { "$ref": "common.schema.json#/$defs/Id" }, "request_id": { "$ref": "common.schema.json#/$defs/Id" },
    "request_seq": { "type": "integer", "minimum": 1 },
    "runtime_id": { "$ref": "common.schema.json#/$defs/Id" }, "session_id": { "$ref": "common.schema.json#/$defs/Id" },
    "owner_id": { "$ref": "common.schema.json#/$defs/Id" }, "generation": { "$ref": "common.schema.json#/$defs/Gen" },
    "payload_sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
    "verb": { "$ref": "common.schema.json#/$defs/VerbName" }, "args": { "type": "object" },
    "pins": { "$ref": "verb.schema.json#/$defs/Pins" },
    "before": { "type": "object", "additionalProperties": false,
                "required": ["frame", "inventory_fingerprint", "target_facts", "receiver_epoch"],
                "properties": { "frame": { "$ref": "common.schema.json#/$defs/Frame" },
                                "inventory_fingerprint": { "$ref": "common.schema.json#/$defs/Sha256" },
                                "target_facts": { "$ref": "common.schema.json#/$defs/Facts" },
                                "receiver_epoch": { "$ref": "common.schema.json#/$defs/Epoch" } } },
    "activity_id": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Id" }, { "type": "null" } ] },
    "decision_id": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Sha256" }, { "type": "null" } ] },
    "occurrence_no": { "type": ["integer", "null"], "minimum": 1 },
    "offer_generation": { "type": ["integer", "null"], "minimum": 1 },
    "actor": { "$ref": "common.schema.json#/$defs/Actor" },
    "admission_class": { "enum": ["A", "B", "C"] },
    "row_key": { "$ref": "verb_phases.schema.json#/$defs/RowKey" },
    "possible_delta": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
                        "items": { "$ref": "verb_phases.schema.json#/$defs/PossibleDelta" } },
    "fence_keys": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 200 } },
    "release_unproven": { "type": "boolean" },
    "released_ms": { "oneOf": [ { "$ref": "common.schema.json#/$defs/WallMs" }, { "type": "null" } ] },
    "state": { "enum": ["recorded", "published", "released", "released_unproven", "result_seen", "final"] },
    "created_ms": { "$ref": "common.schema.json#/$defs/WallMs" }
  },
  "allOf": [ { "if": { "properties": { "decision_id": { "type": "string" } } },
               "then": { "properties": { "occurrence_no": { "type": "integer" }, "offer_generation": { "type": "integer" } } } } ]
}
