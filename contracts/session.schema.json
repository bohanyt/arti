{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arti:contracts/session.schema.json",
  "type": "object",
  "required": ["v", "mod_tick", "native_ms", "acquired_ms", "halt", "rearmed", "fenced_generation", "input_idle",
               "status_answers", "claim_answers", "cancel_answer", "halt_notes"],
  "properties": {
    "v": { "const": "arti.session/3" },
    "mod_tick": { "$ref": "common.schema.json#/$defs/Tick" },
    "native_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
    "acquired_ms": { "oneOf": [ { "type": "null" }, { "$ref": "common.schema.json#/$defs/WallMs" } ],
                     "$comment": "native acquire time of the current (owner_id, generation); deadline_unix_ms = acquired_ms + 1,000" },
    "halt": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/HaltFact" } ] },
    "rearmed": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/Rearmed" } ] },
    "fenced_generation": { "type": "integer", "minimum": 0 },
    "input_idle": { "$ref": "#/$defs/InputIdleSlots" },
    "status_answers": { "type": "array", "maxItems": 8, "items": { "$ref": "attempt_status.schema.json#/$defs/Answer" } },
    "claim_answers": { "type": "array", "maxItems": 8, "items": { "type": "object", "additionalProperties": false,
      "required": ["owner_id", "claim_seq", "receiver_epoch", "result"],
      "properties": { "owner_id": { "$ref": "common.schema.json#/$defs/Id" },
                      "claim_seq": { "type": "integer", "minimum": 1 },
                      "receiver_epoch": { "$ref": "common.schema.json#/$defs/Epoch" },
                      "result": { "enum": ["accepted", "authority_busy", "claim_stale_epoch", "stop_latched", "control_record_fault"] } } } },
    "cancel_answer": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
      "required": ["control_seq", "request_id", "result"],
      "properties": { "control_seq": { "type": "integer", "minimum": 1 },
                      "request_id": { "$ref": "common.schema.json#/$defs/Id" },
                      "result": { "enum": ["applied", "cancel_no_active"] } } } ] },
    "halt_notes": { "type": "array", "maxItems": 4, "uniqueItems": true,
                    "items": { "enum": ["rearm_token_stale", "rearm_token_mismatch", "rearm_waiting_stop_files",
                                        "halt_record_missing", "rearm_token_unlatched", "stop_identity_mismatch"] } }
  },
  "$defs": {
    "HaltEntry": { "type": "object", "additionalProperties": false,
      "required": ["n", "source", "stop_id", "stop_sha256", "cause", "scope", "writer", "latched_ms", "file_present"],
      "properties": { "n": { "type": "integer", "minimum": 1, "maximum": 16 },
                      "source": { "enum": ["stop", "stop_all", "native"] },
                      "stop_id": { "$ref": "common.schema.json#/$defs/Id" },
                      "stop_sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
                      "cause": { "$ref": "common.schema.json#/$defs/StopCause" },
                      "scope": { "$ref": "common.schema.json#/$defs/StopScope" },
                      "writer": { "enum": ["safety", "arti_stop", "launcher", "legacy", "native"] },
                      "latched_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
                      "file_present": { "type": "boolean" } } },
    "HaltFact": { "$comment": "R0-03 §2 native.halt (authoritative)", "type": "object", "additionalProperties": false,
      "required": ["episode_id", "halt_seq", "entries_digest", "scope", "since_ms", "persisted", "entries"],
      "properties": { "episode_id": { "$ref": "common.schema.json#/$defs/Id" },
                      "halt_seq": { "type": "integer", "minimum": 1 },
                      "entries_digest": { "$ref": "common.schema.json#/$defs/Sha256" },
                      "scope": { "$ref": "common.schema.json#/$defs/StopScope" },
                      "since_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
                      "persisted": { "type": "boolean" },
                      "entries": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/HaltEntry" } } } },
    "Rearmed": { "$comment": "R0-03 §2 native.rearmed: the most recent re-arm, kept until the next re-arm (a new episode does not erase it; history only)", "type": "object", "additionalProperties": false,
      "required": ["episode_id", "halt_seq", "stop_ids", "ms"],
      "properties": { "episode_id": { "$ref": "common.schema.json#/$defs/Id" },
                      "halt_seq": { "type": "integer", "minimum": 1 },
                      "stop_ids": { "type": "array", "maxItems": 16, "items": { "$ref": "common.schema.json#/$defs/Id" } },
                      "ms": { "$ref": "common.schema.json#/$defs/WallMs" } } },
    "InputIdle": { "$comment": "R0-05 §3.1 release receipt", "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "request_id", "client", "tick", "frame", "ms", "idle", "via"],
      "properties": { "attempt_id": { "$ref": "common.schema.json#/$defs/Id" },
                      "request_id": { "$ref": "common.schema.json#/$defs/Id" },
                      "client": { "enum": ["inbox", "progression"] },
                      "tick": { "$ref": "common.schema.json#/$defs/Tick" },
                      "frame": { "$ref": "common.schema.json#/$defs/Frame" },
                      "ms": { "$ref": "common.schema.json#/$defs/WallMs" },
                      "idle": { "type": "boolean" },
                      "via": { "enum": ["release", "neutralize", "tick_lapse"] },
                      "lapse": { "type": "object", "additionalProperties": false, "required": ["from_tick", "from_ms", "to_ms"],
                                 "properties": { "from_tick": { "$ref": "common.schema.json#/$defs/Tick" },
                                                 "from_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
                                                 "to_ms": { "$ref": "common.schema.json#/$defs/WallMs" } } } } },
    "InputIdleSlots": { "$comment": "slot `core` holds receipts of client `inbox` (the core's InboxClient); slot `progression` of client `progression`",
      "type": "object", "additionalProperties": false, "required": ["core", "progression"],
      "properties": { "core": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/InputIdle" } ] },
                      "progression": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/InputIdle" } ] } } }
  }
}
