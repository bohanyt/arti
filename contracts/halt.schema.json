{ "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "arti:contracts/halt.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["v", "state", "episode_id", "halt_seq", "scope", "since_ms", "entries", "entries_digest"],
  "properties": { "v": { "const": "arti.halt/1" },
                  "state": { "enum": ["latched", "rearmed"] },
                  "episode_id": { "$ref": "common.schema.json#/$defs/Id" },
                  "halt_seq": { "type": "integer", "minimum": 1 },
                  "scope": { "$ref": "common.schema.json#/$defs/StopScope" },
                  "since_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
                  "entries": { "type": "array", "minItems": 1, "maxItems": 16,
                               "items": { "$ref": "session.schema.json#/$defs/HaltEntry" } },
                  "entries_digest": { "$ref": "common.schema.json#/$defs/Sha256" },
                  "rearmed": { "type": "object", "additionalProperties": false, "required": ["halt_seq", "token_sha256", "ms"],
                               "properties": { "halt_seq": { "type": "integer", "minimum": 1 },
                                               "token_sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
                                               "ms": { "$ref": "common.schema.json#/$defs/WallMs" } } },
                  "last_rearmed": { "$comment": "R0-03 §2/§8 X6 precedence: history of the previous episode's re-arm, copied forward when a new episode overwrites a rearmed file; clears nothing",
                                    "$ref": "session.schema.json#/$defs/Rearmed" } },
  "allOf": [ { "if": { "properties": { "state": { "const": "rearmed" } } }, "then": { "required": ["rearmed"] } } ] }
