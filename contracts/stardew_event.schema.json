{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arti:contracts/stardew_event.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "ts", "game_time", "date", "kind", "facts", "text", "tags", "dedupe_key", "event_id",
               "speak_candidate", "valid_while", "ttl_s", "intent", "situation", "run_id", "session_id"],
  "properties": {
    "schema": { "const": "arti.stardew_event/2" },
    "ts": { "type": "number", "minimum": 0 },
    "game_time": { "type": "string", "maxLength": 32 },
    "date": { "$ref": "stardew_state.schema.json#/properties/date" },
    "kind": { "$ref": "#/$defs/Kind" },
    "facts": { "type": "object", "additionalProperties": false,
               "properties": { "count": { "type": "integer" }, "item": { "type": "string", "maxLength": 80 },
                               "location": { "type": "string", "maxLength": 80 },
                               "from_location": { "type": "string", "maxLength": 80 },
                               "hp": { "type": "integer" }, "start_hp": { "type": "integer" }, "money": { "type": "integer" },
                               "delta": { "type": "integer" }, "weather": { "type": "string", "maxLength": 80 },
                               "text": { "type": "string", "maxLength": 240 }, "level": { "type": "integer" },
                               "chest": { "type": "string", "maxLength": 80 },
                               "items": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
                               "npc": { "type": "string", "maxLength": 80 } } },
    "text": { "type": "string", "pattern": "^Sudah tercatat ", "maxLength": 400 },
    "tags": { "type": "object", "additionalProperties": false,
              "required": ["novel_today", "first_ever", "related_to_intent", "surprise", "danger"],
              "properties": { "novel_today": { "type": "boolean" }, "first_ever": { "type": "boolean" },
                              "related_to_intent": { "type": "boolean" }, "surprise": { "type": "boolean" },
                              "danger": { "type": "boolean" } } },
    "dedupe_key": { "type": "string", "maxLength": 160 },
    "event_id": { "$ref": "common.schema.json#/$defs/Sha256" },
    "speak_candidate": { "type": "boolean" },
    "speech_owner": { "const": "legacy_moment" },
    "valid_while": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["fresh"],
      "properties": { "fresh": { "const": true }, "location": { "type": "string", "maxLength": 80 },
                      "under_attack": { "const": true } } } ] },
    "ttl_s": { "const": 120 },
    "intent": { "type": ["string", "null"], "maxLength": 240 },
    "situation": { "type": "string", "pattern": "^\\[Stardew\\] " },
    "speech_status": { "enum": ["eligible", "stale", "expired"] },
    "run_id": { "$ref": "common.schema.json#/$defs/Id" }, "session_id": { "$ref": "common.schema.json#/$defs/Id" }
  },
  "$defs": { "Kind": { "enum": ["gift_received", "level_up", "knockout", "attack", "sale", "bought", "chest_closed", "arrival",
                                "bed", "shop_closed", "mail_arrived", "caught", "harvested", "planted", "watered", "foraged",
                                "met", "collapsed", "rain_day", "night"] } }
}
