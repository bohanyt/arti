{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arti:contracts/offer.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["v", "offer_id", "generation", "kind", "state", "pending", "page", "choices", "last_results", "feedback"],
  "properties": {
    "v": { "const": "arti.offer/2" },
    "offer_id": { "$ref": "common.schema.json#/$defs/Id" },
    "decision_id": { "$ref": "common.schema.json#/$defs/Sha256" },
    "generation": { "$ref": "common.schema.json#/$defs/Gen" },
    "kind": { "enum": ["force", "in_menu", "activity"] },
    "state": { "type": "object", "additionalProperties": false,
      "required": ["location", "game_time", "energy", "hp", "held", "money", "bag_free", "weather", "minutes_to_0200",
                   "reserve_facts", "owner_recent", "yesterday"],
      "properties": {
        "location": { "$ref": "common.schema.json#/$defs/Text80" },
        "game_time": { "type": "string", "pattern": "^(Spring|Summer|Fall|Winter) [0-9]{1,2} [0-9]{2}:[0-9]{2}$" },
        "energy": { "type": "integer" }, "hp": { "type": "integer" },
        "held": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Text80" }, { "type": "null" } ] },
        "money": { "type": "integer", "minimum": 0 },
        "bag_free": { "type": "integer", "minimum": 0, "maximum": 36 },
        "weather": { "enum": ["sun", "rain", "storm", "snow", "wind", "green_rain", "unknown"] },
        "minutes_to_0200": { "type": "integer", "minimum": 0, "maximum": 1200 },
        "reserve_facts": { "type": "array", "maxItems": 8, "items": { "$ref": "common.schema.json#/$defs/Text160" } },
        "owner_recent": { "type": "array", "maxItems": 3, "items": { "$ref": "common.schema.json#/$defs/Text240" } },
        "yesterday": { "type": "array", "maxItems": 12, "items": { "$ref": "common.schema.json#/$defs/Text240" } },
        "danger": { "type": "array", "maxItems": 4, "items": { "$ref": "common.schema.json#/$defs/Text160" } } } },
    "pending": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
      "required": ["decision_id", "receiver_kind", "prompt_text", "age_s"],
      "properties": { "decision_id": { "$ref": "common.schema.json#/$defs/Sha256" },
                      "receiver_kind": { "$ref": "observation.schema.json#/$defs/Ui/properties/kind" },
                      "prompt_text": { "type": "string", "maxLength": 480 },
                      "age_s": { "type": "integer", "minimum": 0 } } } ] },
    "page": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["index", "count"],
              "properties": { "index": { "type": "integer", "minimum": 0 }, "count": { "type": "integer", "minimum": 1 } } } ] },
    "choices": { "type": "array", "minItems": 1, "maxItems": 24, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "label", "does"],
      "properties": {
        "id": { "type": "string", "pattern": "^c([1-9]|1[0-9]|2[0-4])$" },
        "kind": { "enum": ["activity", "resume", "ui", "interact", "answer", "transfer", "wait", "page", "observe"] },
        "label": { "$ref": "common.schema.json#/$defs/Text80" },
        "does": { "$ref": "common.schema.json#/$defs/Text160" },
        "unavailable_reason": { "type": "object", "additionalProperties": false, "required": ["code", "text"],
                                "properties": { "code": { "$ref": "unavailable_reasons.schema.json#/$defs/Code" },
                                                "text": { "$ref": "common.schema.json#/$defs/Text80" } } } } } },
    "last_results": { "type": "array", "maxItems": 3, "items": { "$ref": "common.schema.json#/$defs/Text160" } },
    "feedback": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
      "required": ["received", "why_rejected", "valid_ids"],
      "properties": { "received": { "type": "string", "maxLength": 64 },
                      "why_rejected": { "enum": ["malformed", "unknown_id", "unavailable", "superseded", "material_changed",
                                                 "capacity_exhausted"] },
                      "valid_ids": { "type": "array", "maxItems": 24,
                                     "items": { "type": "string", "pattern": "^c([1-9]|1[0-9]|2[0-4])$" } } } } ] }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "enum": ["force", "in_menu"] } } }, "then": { "required": ["decision_id"] } },
    { "if": { "properties": { "kind": { "const": "force" } } },
      "then": { "properties": { "choices": { "not": { "contains": { "properties": { "kind": { "const": "wait" } } } } } } } },
    { "properties": { "choices": { "contains": { "properties": { "kind": { "const": "observe" } } } } } }
  ]
}
