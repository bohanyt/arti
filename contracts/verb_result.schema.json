{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arti:contracts/verb_result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["v", "request_id", "attempt_id", "verb", "actor", "client", "generation", "executed", "not_executed", "delivered",
               "edges", "released", "released_via", "release_receipt", "receiver_epoch_before", "receiver_epoch_after",
               "validity", "succession", "transition_after", "barrier_after", "debts_after", "closure", "witnesses",
               "native_lifecycle", "obs_revision_after", "obs_pending", "timing", "faults"],
  "properties": {
    "v": { "const": "arti.verb_result/3" },
    "request_id": { "$ref": "common.schema.json#/$defs/Id" },
    "attempt_id": { "$ref": "common.schema.json#/$defs/Id" },
    "verb": { "$ref": "common.schema.json#/$defs/VerbName" },
    "actor": { "$ref": "common.schema.json#/$defs/Actor" },
    "client": { "const": "inbox" },
    "generation": { "$ref": "common.schema.json#/$defs/Gen" },
    "executed": { "type": "boolean" },
    "not_executed": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
      "required": ["reason", "native_code", "detail"],
      "properties": { "reason": { "$ref": "refusals.schema.json#/$defs/Code" },
                      "native_code": { "type": "string", "maxLength": 64 },
                      "detail": { "type": "string", "maxLength": 240 },
                      "debt_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                      "cancel_reason": { "$ref": "refusals.schema.json#/$defs/CancelReason" },
                      "facts": { "$ref": "common.schema.json#/$defs/Facts" } } } ] },
    "delivered": { "type": "boolean" },
    "edges": { "type": "integer", "minimum": 0 },
    "released": { "type": "boolean" },
    "released_via": { "enum": ["release", "neutralize", "tick_lapse", null] },
    "release_receipt": { "oneOf": [ { "type": "null" }, { "$ref": "session.schema.json#/$defs/InputIdle" } ] },
    "receiver_epoch_before": { "$ref": "common.schema.json#/$defs/Epoch" },
    "receiver_epoch_after": { "$ref": "common.schema.json#/$defs/Epoch" },
    "owned_by_after": { "$ref": "observation.schema.json#/$defs/Ui/properties/owned_by" },
    "validity": { "type": "object", "additionalProperties": false, "required": ["phase_at_end", "ended_by", "adopted"],
      "properties": { "phase_at_end": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
                      "ended_by": { "enum": ["completed", "legal_successor", "foreign_epoch", "validity_violation", "cancel",
                                             "stop", "lease", "focus", "barrier", "no_input"] },
                      "adopted": { "type": "array", "maxItems": 8, "items": {
                        "type": "object", "additionalProperties": false, "required": ["from_epoch", "to_epoch", "phase", "via"],
                        "properties": { "from_epoch": { "$ref": "common.schema.json#/$defs/Epoch" },
                                        "to_epoch": { "$ref": "common.schema.json#/$defs/Epoch" },
                                        "phase": { "type": "string", "maxLength": 32 },
                                        "via": { "enum": ["edge", "controller_continuation"] } } } } } },
    "succession": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
      "required": ["edge", "authenticated", "via", "in_legal_set"],
      "properties": { "edge": { "enum": ["none", "closed", "replaced", "opened"] }, "authenticated": { "type": "boolean" },
                      "via": { "enum": ["edge", "continuation", null] }, "in_legal_set": { "type": "boolean" },
                      "receiver_id_after": { "$ref": "common.schema.json#/$defs/NativeToken" },
                      "menu_type_after": { "type": "string", "maxLength": 96 } } } ] },
    "transition_after": { "enum": [null, "fade", "warp", "event", "save", "minigame", "fishing", "cutscene"] },
    "barrier_after": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
      "required": ["kind", "instance_id"],
      "properties": { "kind": { "$ref": "common.schema.json#/$defs/BarrierKind" },
                      "instance_id": { "$ref": "common.schema.json#/$defs/NativeToken" } } } ] },
    "debts_after": { "type": "array", "maxItems": 8,
                     "items": { "$ref": "observation.schema.json#/$defs/Native/properties/debts/items" } },
    "closure": { "type": "object", "additionalProperties": false, "required": ["closed", "witness", "frame"],
      "properties": { "closed": { "type": "boolean" },
                      "witness": { "type": "array", "uniqueItems": true,
                                   "items": { "$ref": "verb_phases.schema.json#/$defs/ClosureWitness" } },
                      "markers": { "type": "array", "uniqueItems": true,
                                   "items": { "$ref": "verb_phases.schema.json#/$defs/Marker" } },
                      "frame": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Frame" }, { "type": "null" } ] } } },
    "witnesses": { "type": "array", "maxItems": 32, "items": { "type": "object", "additionalProperties": false,
      "required": ["kind", "target", "before", "after", "frame"],
      "properties": { "kind": { "oneOf": [ { "$ref": "verb_phases.schema.json#/$defs/EffectKind" }, { "const": "witness_unavailable" } ] },
                      "target": { "type": "string", "maxLength": 160 },
                      "before": { "$ref": "common.schema.json#/$defs/Facts" },
                      "after": { "$ref": "common.schema.json#/$defs/Facts" },
                      "frame": { "$ref": "common.schema.json#/$defs/Frame" },
                      "item": { "$ref": "common.schema.json#/$defs/ItemRef" },
                      "qty": { "type": "integer" }, "price": { "type": "integer", "minimum": 0 } } } },
    "native_lifecycle": { "enum": ["not_admitted", "admitted", "armed", "settled", "uncertain", "cancelled", "faulted"] },
    "obs_revision_after": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Frame" }, { "type": "null" } ] },
    "obs_pending": { "type": "boolean" },
    "timing": { "type": "object", "additionalProperties": false,
      "required": ["admit_tick", "first_edge_tick", "release_tick", "final_tick"],
      "properties": { "admit_tick": { "type": ["integer", "null"], "minimum": 0 },
                      "first_edge_tick": { "type": ["integer", "null"], "minimum": 0 },
                      "release_tick": { "type": ["integer", "null"], "minimum": 0 },
                      "final_tick": { "type": "integer", "minimum": 0 } } },
    "faults": { "type": "array", "maxItems": 16, "items": { "type": "string", "pattern": "^[A-Z0-9_]{2,64}$" } }
  },
  "allOf": [
    { "if": { "properties": { "executed": { "const": false } } },
      "then": { "properties": { "not_executed": { "type": "object" }, "delivered": { "const": false }, "edges": { "const": 0 },
                                "validity": { "properties": { "ended_by": { "const": "no_input" } } } } },
      "else": { "properties": { "not_executed": { "type": "null" } } } },
    { "if": { "properties": { "released": { "const": true } } },
      "then": { "properties": { "release_receipt": { "type": "object" }, "released_via": { "type": "string" } } } },
    { "if": { "properties": { "not_executed": { "properties": { "reason": { "const": "cancelled" } }, "required": ["reason"] } } },
      "then": { "properties": { "not_executed": { "required": ["cancel_reason"] } } } }
  ]
}
