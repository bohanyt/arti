{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arti:contracts/common.schema.json",
  "$defs": {
    "Sha256":     { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "Id":         { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/|-]+$" },
    "NativeToken":{ "type": "string", "minLength": 1, "maxLength": 128 },
    "WallMs":     { "type": "integer", "minimum": 0 },
    "Frame":      { "type": "integer", "minimum": 0 },
    "Tick":       { "type": "integer", "minimum": 0 },
    "Epoch":      { "type": "integer", "minimum": 0 },
    "Gen":        { "type": "integer", "minimum": 1 },
    "Text80":     { "type": "string", "maxLength": 80 },
    "Text160":    { "type": "string", "maxLength": 160 },
    "Text240":    { "type": "string", "maxLength": 240 },
    "Season":     { "enum": ["spring", "summer", "fall", "winter"] },
    "GameDate": {
      "type": "object", "additionalProperties": false, "required": ["year", "season", "day"],
      "properties": { "year": { "type": "integer", "minimum": 1 }, "season": { "$ref": "#/$defs/Season" },
                      "day": { "type": "integer", "minimum": 1, "maximum": 28 } } },
    "Point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } } },
    "Vec2": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "ItemRef": {
      "type": "object", "additionalProperties": false, "required": ["item_id", "qty", "quality"],
      "properties": {
        "item_id":  { "type": "string", "minLength": 1, "maxLength": 96 },
        "name":     { "$ref": "#/$defs/Text80" },
        "qty":      { "type": "integer", "minimum": 0, "maximum": 999 },
        "quality":  { "enum": [0, 1, 2, 4] },
        "category": { "type": "string", "maxLength": 48 },
        "protected":{ "type": "boolean" } } },
    "Scalar": { "type": ["string", "number", "integer", "boolean", "null"], "maxLength": 240 },
    "Facts":  { "type": "object", "maxProperties": 24,
                "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                "additionalProperties": { "anyOf": [ { "$ref": "#/$defs/Scalar" },
                  { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/Scalar" } } ] } },
    "VerbName": { "enum": ["observe", "move", "interact", "use", "select", "ui", "transfer", "run_controller"] },
    "Actor":    { "enum": ["model", "activity", "safety", "legacy"] },
    "JournalActor": { "enum": ["model", "activity", "safety", "progression", "legacy", "slot", "operator", "host", "core"] },
    "EValue":   { "enum": ["E0", "E1", "E2", "E3", "E4"] },
    "SettleClass": { "enum": ["HAZARD", "OWNED", "DECISION_PENDING", "IN_MENU", "TRANSITION", "SETTLED", "OBSERVE"] },
    "Outcome":  { "enum": ["SAFETY_STOP", "VERIFIED", "NOT_EXECUTED", "PRECONDITION", "CLEAN_FAIL", "UNCERTAIN"] },
    "Bucket": { "enum": ["outcome-game", "outcome-agency", "info", "defect-motor", "defect-adapter", "defect-lost-decision",
                         "defect-lifecycle", "defect-effect-integrity", "defect-own-fence", "defect-unanswered-decision",
                         "defect-sensing", "core-defect-host-hold", "defect-unclassified", "apparatus-helper-policy",
                         "apparatus", "hazard"] },
    "HazardCode": { "enum": ["H1", "H2a", "H2b", "H2c", "H2d", "H2e", "H3", "H4", "H5"] },
    "StopCause":  { "enum": ["H1", "H2", "H3", "H4", "H5", "identity", "owner", "operator", "legacy", "malformed",
                             "halt_record_corrupt", "native_containment", "native_unclean_exit", "entries_overflow"] },
    "StopScope":  { "enum": ["core", "all"] },
    "BarrierKind": { "enum": ["warp_fade", "event", "sleep_ready", "night", "passout_0200", "passout_same_day",
                              "ko_recovery", "festival_start", "festival_end", "host_pause", "reconnect"] },
    "NightStage": { "enum": ["day_ending", "levelup", "shipping_summary", "ok_accepted", "outro", "save_menu",
                             "first_draw", "saved", "day_started", "control_restored", "plan"] },
    "DebtKind": { "enum": ["chest_mutex", "late_open", "cursor_item", "using_tool", "input_release"] },
    "AllowedOp": { "type": "string",
                   "pattern": "^(observe|move|interact|use|select|ui|transfer|run_controller)(:(press_a|press_b|secondary|scroll|type|close|advance|open_menu))?$" },
    "EffectKey": {
      "type": "object", "additionalProperties": false, "required": ["kind", "subject", "frame"],
      "properties": { "kind": { "$ref": "verb_phases.schema.json#/$defs/EffectKind" },
                      "subject": { "type": "string", "minLength": 1, "maxLength": 160 },
                      "frame": { "type": ["integer", "null"], "minimum": 0 } } }
  }
}
