{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arti:contracts/host_status.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["v", "kind", "utc_ms", "heartbeat_seq", "run_id", "save_id", "host_id", "farmhand_id", "game_version",
               "waiting_on", "ready_check", "host", "peer", "gifts", "policy", "io", "host_stop"],
  "properties": {
    "v": { "const": "arti.host_status/2" },
    "kind": { "enum": ["helper", "human"] },
    "utc_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
    "heartbeat_seq": { "type": "integer", "minimum": 0 },
    "run_id": { "$ref": "common.schema.json#/$defs/Id" }, "save_id": { "$ref": "common.schema.json#/$defs/Id" },
    "host_id": { "type": "integer" }, "farmhand_id": { "type": ["integer", "null"] },
    "game_version": { "type": "string", "maxLength": 32 },
    "waiting_on": { "$ref": "#/$defs/WaitingOn" },
    "ready_check": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
      "required": ["kind", "ready_count", "total", "local_ready", "since_ms"],
      "properties": { "kind": { "enum": ["sleep", "festivalStart", "festivalEnd", "other"] },
                      "ready_count": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 },
                      "local_ready": { "type": "boolean" }, "since_ms": { "$ref": "common.schema.json#/$defs/WallMs" } } } ] },
    "host": { "type": "object", "additionalProperties": false,
              "required": ["location", "tile", "menu_type", "in_bed", "ready", "paused", "time_of_day", "date"],
              "properties": { "location": { "type": ["string", "null"], "maxLength": 80 },
                              "tile": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Point" }, { "type": "null" } ] },
                              "menu_type": { "type": ["string", "null"], "maxLength": 96 },
                              "in_bed": { "type": "boolean" }, "ready": { "type": "boolean" }, "paused": { "type": "boolean" },
                              "time_of_day": { "type": "integer", "minimum": 600, "maximum": 2600 },
                              "date": { "$ref": "common.schema.json#/$defs/GameDate" } } },
    "peer": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
      "required": ["location", "tile", "moving", "in_bed", "ready", "hp_pct", "monsters_in_location"],
      "properties": { "location": { "type": ["string", "null"], "maxLength": 80 },
                      "tile": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Point" }, { "type": "null" } ] },
                      "moving": { "type": "boolean" }, "in_bed": { "type": "boolean" }, "ready": { "type": "boolean" },
                      "hp_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
                      "monsters_in_location": { "type": "integer", "minimum": 0 } } } ] },
    "gifts": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
      "required": ["schedule_id", "next_due_ms", "last"],
      "properties": { "schedule_id": { "$ref": "common.schema.json#/$defs/Id" },
                      "next_due_ms": { "type": ["integer", "null"], "minimum": 0 },
                      "last": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
                        "required": ["proposal_id", "item_id", "qty", "trigger", "shown_ms", "outcome", "outcome_ms"],
                        "properties": { "proposal_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                                        "item_id": { "type": "string", "maxLength": 96 },
                                        "qty": { "type": "integer", "minimum": 1 },
                                        "trigger": { "enum": ["schedule", "random_moving", "random_idle"] },
                                        "shown_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
                                        "outcome": { "enum": ["pending", "accepted", "declined", "withdrawn_180s"] },
                                        "outcome_ms": { "type": ["integer", "null"], "minimum": 0 } } } ] } } } ] },
    "policy": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
      "required": ["ready_checks", "proposal_withdraw_s", "save_wait_s", "sleep_by", "replies", "festival_calendar_id"],
      "properties": { "ready_checks": { "type": "array", "items": { "enum": ["sleep", "festivalStart", "festivalEnd"] } },
                      "proposal_withdraw_s": { "const": 180 }, "save_wait_s": { "const": 195 },
                      "sleep_by": { "const": 2550 },
                      "replies": { "type": "object", "additionalProperties": false,
                                   "required": ["item_gift", "other_proposal", "farmer_talk"],
                                   "properties": { "item_gift": { "const": "accept" }, "other_proposal": { "const": "decline" },
                                                   "farmer_talk": { "const": "none" } } },
                      "festival_calendar_id": { "type": ["string", "null"], "maxLength": 64 } } } ] },
    "io": { "type": "object", "additionalProperties": false, "required": ["retries_total", "last_error"],
            "properties": { "retries_total": { "type": "integer", "minimum": 0 },
                            "last_error": { "type": ["string", "null"], "maxLength": 120 } } },
    "host_stop": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
      "required": ["reason", "detail", "ms", "waiting_on"],
      "properties": { "reason": { "enum": ["unconfigured_ready_check", "unconfigured_menu", "unconfigured_host_text",
                                           "profession_policy_required", "unconfigured_festival_question", "identity_mismatch",
                                           "io_failure"] },
                      "detail": { "type": "string", "maxLength": 120 },
                      "ms": { "$ref": "common.schema.json#/$defs/WallMs" },
                      "waiting_on": { "$ref": "#/$defs/WaitingOn" } } } ] }
  },
  "$defs": {
    "WaitingOn": { "type": "object", "additionalProperties": false, "required": ["kind", "since_frame", "since_ms"],
      "properties": { "kind": { "enum": ["none", "proposal", "ready_check", "save", "menu"] },
                      "menu_type": { "type": "string", "maxLength": 96 },
                      "opener": { "enum": ["host", "peer", "native", "unknown"] },
                      "proposal_sender_id": { "type": "integer" },
                      "proposal_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                      "since_frame": { "type": ["integer", "null"], "minimum": 0 },
                      "since_ms": { "type": ["integer", "null"], "minimum": 0 } },
      "allOf": [ { "if": { "properties": { "kind": { "const": "menu" } } }, "then": { "required": ["menu_type"] } },
                 { "if": { "properties": { "kind": { "const": "proposal" } } },
                   "then": { "required": ["proposal_sender_id", "proposal_id"] } } ] }
  }
}
