{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arti:contracts/candidate_manifest.schema.json",
  "$comment": "R0-09 §3 arti.candidate_manifest/1 (authoritative there; H-1..H-8, M-1..M-4). Leaf types not written in R0-09: # SPEC-Q ADR-15 item 7",
  "type": "object", "additionalProperties": false,
  "required": ["v", "candidate", "core_pins", "apparatus", "policy_receipt_sha256"],
  "properties": {
    "v": { "const": "arti.candidate_manifest/1" },
    "candidate": { "type": "object", "additionalProperties": false,
      "required": ["id", "phase", "parent", "question", "both_sides_exception", "frozen_utc", "reviewer", "judge_receipt"],
      "properties": { "id": { "$ref": "common.schema.json#/$defs/Id" },
                      "phase": { "type": "string", "pattern": "^R[0-5][abc]?$", "$comment": "R0-09 §6.2 phase names" },
                      "parent": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Id" }, { "type": "null" } ] },
                      "question": { "type": "string", "minLength": 1, "maxLength": 400 },
                      "both_sides_exception": { "oneOf": [ { "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 400 } ] },
                      "frozen_utc": { "type": "string", "format": "date-time" },
                      "reviewer": { "type": "string", "minLength": 1, "maxLength": 64 },
                      "judge_receipt": { "oneOf": [ { "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 200 } ] } } },
    "core_pins": { "type": "object", "additionalProperties": false,
      "required": ["commit", "clean", "trees", "dll", "config", "models", "platform"],
      "properties": {
        "commit": { "$ref": "#/$defs/GitSha" },
        "clean": { "const": true },
        "trees": { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                   "additionalProperties": { "$ref": "#/$defs/GitSha" } },
        "dll": { "type": "object", "additionalProperties": false,
                 "required": ["farmhand", "host_bridge", "helper", "source_trees", "build"],
                 "properties": { "farmhand": { "$ref": "common.schema.json#/$defs/Sha256" },
                                 "host_bridge": { "$ref": "common.schema.json#/$defs/Sha256", "$comment": "must equal farmhand (IC-2 lint)" },
                                 "helper": { "$ref": "common.schema.json#/$defs/Sha256" },
                                 "source_trees": { "type": "object", "additionalProperties": false, "required": ["farmhand", "helper"],
                                                   "properties": { "farmhand": { "$ref": "#/$defs/GitSha" },
                                                                   "helper": { "$ref": "#/$defs/GitSha" } } },
                                 "build": { "type": "object", "additionalProperties": false, "required": ["machine", "sdk", "modbuildconfig"],
                                            "properties": { "machine": { "type": "string", "maxLength": 64 },
                                                            "sdk": { "type": "string", "maxLength": 64 },
                                                            "modbuildconfig": { "const": "4.4.0" } } } } },
        "config": { "type": "object", "additionalProperties": false,
                    "required": ["farmhand_mod", "host_mod", "trial_or_core", "startup_preferences", "env_digest"],
                    "properties": { "farmhand_mod": { "$ref": "common.schema.json#/$defs/Sha256" },
                                    "host_mod": { "$ref": "common.schema.json#/$defs/Sha256" },
                                    "trial_or_core": { "$ref": "common.schema.json#/$defs/Sha256" },
                                    "startup_preferences": { "type": "object", "additionalProperties": false,
                                                             "required": ["raw_sha256", "effective_sha256"],
                                                             "properties": { "raw_sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
                                                                             "effective_sha256": { "$ref": "common.schema.json#/$defs/Sha256" } } },
                                    "env_digest": { "$ref": "common.schema.json#/$defs/Sha256" } } },
        "models": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
          "required": ["pos", "provider_kind", "model", "effort", "service_tier", "transport", "enabled", "derived_from"],
          "properties": { "pos": { "type": "integer", "minimum": 0 },
                          "provider_kind": { "enum": ["codex", "claude"] },
                          "model": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "astra" },
                                     "$comment": "H-5: an astra model makes the manifest invalid" },
                          "effort": { "type": ["string", "null"], "maxLength": 32 },
                          "service_tier": { "type": ["string", "null"], "maxLength": 32 },
                          "transport": { "type": "string", "maxLength": 32 },
                          "enabled": { "type": "boolean" },
                          "derived_from": { "oneOf": [ { "type": "null" }, { "type": "integer", "minimum": 0 } ],
                                            "$comment": "pos of the entry a code-derived fallback comes from (D-10)" } } } },
        "platform": { "type": "object", "additionalProperties": false,
          "required": ["game", "smapi", "python", "sdks", "codex_cli", "mods"],
          "properties": {
            "game": { "type": "object", "additionalProperties": false, "required": ["version", "game1_mvid"],
                      "properties": { "version": { "type": "string", "maxLength": 32 },
                                      "game1_mvid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" } } },
            "smapi": { "type": "object", "additionalProperties": false, "required": ["version", "sha256"],
                       "properties": { "version": { "type": "string", "maxLength": 32 },
                                       "sha256": { "$ref": "common.schema.json#/$defs/Sha256" } } },
            "python": { "type": "object", "additionalProperties": false, "required": ["version", "exe_sha256", "freeze_sha256"],
                        "properties": { "version": { "type": "string", "maxLength": 32 },
                                        "exe_sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
                                        "freeze_sha256": { "$ref": "common.schema.json#/$defs/Sha256" } } },
            "sdks": { "type": "object", "additionalProperties": false, "required": ["openai_codex", "anthropic"],
                      "properties": { "openai_codex": { "type": "string", "maxLength": 32 },
                                      "anthropic": { "type": ["string", "null"], "maxLength": 32 } } },
            "codex_cli": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "version"],
                           "properties": { "path": { "type": "string", "maxLength": 260 },
                                           "sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
                                           "version": { "type": "string", "maxLength": 32 } } },
            "mods": { "type": "object", "additionalProperties": false, "required": ["farmhand", "host"],
                      "properties": { "farmhand": { "$ref": "#/$defs/ModList" }, "host": { "$ref": "#/$defs/ModList" } } } } } } },
    "apparatus": { "type": "object", "additionalProperties": false,
                   "required": ["machine", "host_template_sha256", "helper_config", "save_fixture"],
                   "properties": { "machine": { "type": "string", "maxLength": 64 },
                                   "host_template_sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
                                   "helper_config": { "$ref": "#/$defs/MapDigests" },
                                   "save_fixture": { "$ref": "#/$defs/MapDigests" } } },
    "policy_receipt_sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
    "window": { "$comment": "per window (written at window start and at run_closed); not part of identity (H-6)",
      "type": "object", "additionalProperties": false,
      "required": ["id", "map", "start_pins_digest", "end_pins_digest", "run_start_state", "loaded_closure", "outside_pins"],
      "properties": { "id": { "$ref": "common.schema.json#/$defs/Id" },
                      "map": { "type": "string", "maxLength": 64 },
                      "start_pins_digest": { "$ref": "common.schema.json#/$defs/Sha256" },
                      "end_pins_digest": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Sha256" }, { "type": "null" } ] },
                      "run_start_state": { "type": "object", "additionalProperties": false,
                                           "required": ["save", "memory_files", "wiki_cache", "accounting_head"],
                                           "properties": { "save": { "$ref": "common.schema.json#/$defs/Sha256" },
                                                           "memory_files": { "$ref": "common.schema.json#/$defs/Sha256" },
                                                           "wiki_cache": { "$ref": "common.schema.json#/$defs/Sha256" },
                                                           "accounting_head": { "type": "string", "maxLength": 128 } } },
                      "loaded_closure": { "type": "array", "items": { "type": "object", "additionalProperties": false,
                        "required": ["process_role", "argv", "executable_sha256", "files"],
                        "properties": { "process_role": { "type": "string", "maxLength": 64 },
                                        "argv": { "type": "array", "items": { "type": "string" } },
                                        "executable_sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
                                        "files": { "type": "array", "items": { "type": "object", "additionalProperties": false,
                                          "required": ["path", "sha256"],
                                          "properties": { "path": { "type": "string", "maxLength": 260 },
                                                          "sha256": { "$ref": "common.schema.json#/$defs/Sha256" } } } } } } },
                      "outside_pins": { "type": "array", "items": { "type": "string", "maxLength": 260 },
                                        "$comment": "non-empty -> HP-1 (M-3)" } } }
  },
  "$defs": {
    "GitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "MapDigests": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                    "additionalProperties": { "$ref": "common.schema.json#/$defs/Sha256" } },
    "ModList": { "type": "array", "items": { "type": "object", "additionalProperties": false,
                 "required": ["unique_id", "version", "entry_sha256"],
                 "properties": { "unique_id": { "type": "string", "maxLength": 128 },
                                 "version": { "type": "string", "maxLength": 32 },
                                 "entry_sha256": { "$ref": "common.schema.json#/$defs/Sha256" } } } }
  }
}
