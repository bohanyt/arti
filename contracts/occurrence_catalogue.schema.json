{ "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "arti:contracts/occurrence_catalogue.schema.json",
  "type": "object", "additionalProperties": false, "required": ["v", "kinds"],
  "properties": { "v": { "const": "arti.occurrence_catalogue/1" },
    "kinds": { "type": "object", "additionalProperties": false,
      "patternProperties": { "^[a-z_]+$": { "type": "object", "additionalProperties": false,
        "required": ["native_hook", "effect_key", "persona_fact", "event_kind"],
        "properties": { "native_hook": { "type": "string", "maxLength": 120 },
                        "effect_key": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
                          "required": ["kind", "subject_from"],
                          "properties": { "kind": { "oneOf": [ { "$ref": "verb_phases.schema.json#/$defs/EffectKind" },
                                                               { "const": "facts.effect_kind" } ] },
                                          "subject_from": { "enum": ["subject", "facts.item_id", "facts.proposal_id"] },
                                          "when": { "type": "object" } } } ] },
                        "persona_fact": { "type": "boolean" },
                        "event_kind": { "oneOf": [ { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" }, { "type": "null" } ] } } } } } } }
