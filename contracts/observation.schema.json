{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arti:contracts/observation.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["v", "rev", "captured_tick", "captured_ms", "identity", "clock", "player", "location", "ui", "inventory",
               "world", "native", "host", "capabilities", "loss"],
  "properties": {
    "v": { "const": "arti.observation/3" },
    "rev": { "type": "object", "additionalProperties": false,
             "required": ["frame", "scene", "ui", "inventory", "player", "host"],
             "properties": { "frame": { "$ref": "common.schema.json#/$defs/Frame" },
                             "scene": { "type": "integer", "minimum": 0 }, "ui": { "type": "integer", "minimum": 0 },
                             "inventory": { "type": "integer", "minimum": 0 }, "player": { "type": "integer", "minimum": 0 },
                             "host": { "type": "integer", "minimum": 0 } } },
    "captured_tick": { "$ref": "common.schema.json#/$defs/Tick" },
    "captured_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
    "identity": { "type": "object", "additionalProperties": false,
                  "required": ["save_id", "player_id", "is_main_player", "session_id", "runtime_id"],
                  "properties": { "save_id": { "$ref": "common.schema.json#/$defs/Id" },
                                  "player_id": { "type": "integer" },
                                  "is_main_player": { "const": false },
                                  "session_id": { "$ref": "common.schema.json#/$defs/Id" },
                                  "runtime_id": { "$ref": "common.schema.json#/$defs/Id" } } },
    "clock": { "type": "object", "additionalProperties": false,
               "required": ["date", "time_of_day", "day_of_week", "weather", "host_paused", "game_paused", "saving"],
               "properties": { "date": { "$ref": "common.schema.json#/$defs/GameDate" },
                               "time_of_day": { "type": "integer", "minimum": 600, "maximum": 2600 },
                               "day_of_week": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] },
                               "weather": { "enum": ["sun", "rain", "storm", "snow", "wind", "green_rain", "unknown"] },
                               "host_paused": { "type": "boolean" }, "game_paused": { "type": "boolean" },
                               "saving": { "type": "boolean" } } },
    "player": { "type": "object", "additionalProperties": false,
                "required": ["tile", "pos", "facing", "hp", "max_hp", "stamina", "max_stamina", "can_move", "using_tool",
                             "held", "cursor"],
                "properties": { "tile": { "$ref": "common.schema.json#/$defs/Point" },
                                "pos": { "$ref": "common.schema.json#/$defs/Vec2" },
                                "facing": { "enum": ["n", "e", "s", "w"] },
                                "hp": { "type": "integer" }, "max_hp": { "type": "integer", "minimum": 1 },
                                "stamina": { "type": "number" }, "max_stamina": { "type": "number", "minimum": 1 },
                                "can_move": { "type": "boolean" }, "using_tool": { "type": "boolean" },
                                "held": { "oneOf": [ { "$ref": "common.schema.json#/$defs/ItemRef" }, { "type": "null" } ] },
                                "cursor": { "oneOf": [ { "$ref": "common.schema.json#/$defs/ItemRef" }, { "type": "null" } ] } } },
    "location": { "type": "object", "additionalProperties": false,
                  "required": ["name", "kind", "size", "exits", "is_own_home"],
                  "properties": { "name": { "$ref": "common.schema.json#/$defs/Text80" },
                                  "kind": { "enum": ["farm", "farmhouse", "cabin", "town", "building", "shop", "mine",
                                                     "outdoor", "festival", "other"] },
                                  "size": { "$ref": "common.schema.json#/$defs/Point" },
                                  "exits": { "type": "array", "maxItems": 32, "items": {
                                    "type": "object", "additionalProperties": false, "required": ["exit_id", "kind", "tile"],
                                    "properties": { "exit_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                                                    "kind": { "enum": ["warp", "door", "ladder", "edge", "other"] },
                                                    "tile": { "$ref": "common.schema.json#/$defs/Point" },
                                                    "target_name": { "$ref": "common.schema.json#/$defs/Text80" } } } },
                                  "is_own_home": { "type": "boolean" } } },
    "ui": { "$ref": "#/$defs/Ui" },
    "inventory": { "type": "object", "additionalProperties": false, "required": ["slots", "money", "fingerprint"],
                   "properties": { "slots": { "type": "array", "maxItems": 36, "items": {
                                     "type": "object", "additionalProperties": false, "required": ["slot", "item"],
                                     "properties": { "slot": { "type": "integer", "minimum": 0, "maximum": 35 },
                                                     "item": { "oneOf": [ { "$ref": "common.schema.json#/$defs/ItemRef" },
                                                                          { "type": "null" } ] } } } },
                                   "money": { "type": "integer", "minimum": 0 },
                                   "fingerprint": { "$ref": "common.schema.json#/$defs/Sha256" } } },
    "world": { "type": "object", "additionalProperties": false, "required": ["targets", "monsters", "npcs"],
               "properties": {
                 "targets": { "type": "array", "maxItems": 64, "items": {
                   "type": "object", "additionalProperties": false, "required": ["target_id", "kind", "tile", "facts"],
                   "properties": { "target_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                                   "kind": { "$ref": "verb_phases.schema.json#/$defs/TargetKind",
                                             "$comment": "closed T-CL target-kind enum (R0-05 §4.3)" },
                                   "tile": { "$ref": "common.schema.json#/$defs/Point" },
                                   "facts": { "$ref": "common.schema.json#/$defs/Facts" } } } },
                 "monsters": { "type": "array", "maxItems": 32, "items": {
                   "type": "object", "additionalProperties": false, "required": ["monster_id", "kind", "tile", "distance_tiles"],
                   "properties": { "monster_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                                   "kind": { "$ref": "common.schema.json#/$defs/Text80" },
                                   "tile": { "$ref": "common.schema.json#/$defs/Point" },
                                   "distance_tiles": { "type": "number", "minimum": 0 },
                                   "hp": { "type": "integer" } } } },
                 "npcs": { "type": "array", "maxItems": 32, "items": {
                   "type": "object", "additionalProperties": false, "required": ["npc_id", "name", "tile"],
                   "properties": { "npc_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                                   "name": { "$ref": "common.schema.json#/$defs/Text80" },
                                   "tile": { "$ref": "common.schema.json#/$defs/Point" } } } } } },
    "native": { "$ref": "#/$defs/Native" },
    "host": { "type": "object", "additionalProperties": false, "required": ["waiting_on", "ready_check", "saving", "paused"],
              "properties": { "waiting_on": { "$ref": "host_status.schema.json#/$defs/WaitingOn" },
                              "ready_check": { "oneOf": [ { "type": "null" }, {
                                "type": "object", "additionalProperties": false,
                                "required": ["kind", "ready_count", "total", "local_ready"],
                                "properties": { "kind": { "enum": ["sleep", "festivalStart", "festivalEnd", "other"] },
                                                "ready_count": { "type": "integer", "minimum": 0 },
                                                "total": { "type": "integer", "minimum": 0 },
                                                "local_ready": { "type": "boolean" } } } ] },
                              "saving": { "type": "boolean" }, "paused": { "type": "boolean" } } },
    "capabilities": { "type": "object", "additionalProperties": false, "required": ["backend", "caps"],
                      "properties": { "backend": { "enum": ["background", "focused"] },
                                      "caps": { "type": "array", "uniqueItems": true, "items": {
                                        "enum": ["pointer", "text", "polledPad", "uiFrame", "vanillaMenuDispatch",
                                                 "focusRequired", "open_menu", "shoulder_buttons", "pagination"] } } } },
    "loss": { "type": "object", "additionalProperties": false,
              "required": ["text_truncated", "targets_truncated", "snapshot_resync"],
              "properties": { "text_truncated": { "type": "boolean" }, "targets_truncated": { "type": "boolean" },
                              "snapshot_resync": { "type": "boolean" } } }
  },
  "$defs": {
    "Ui": { "type": "object", "additionalProperties": false,
      "required": ["receiver_id", "receiver_epoch", "menu_type", "kind", "owned_by", "authority", "controls",
                   "prompt_digest", "options_digest", "text", "text_loss", "page", "actionable", "stack", "parked"],
      "properties": {
        "receiver_id": { "oneOf": [ { "$ref": "common.schema.json#/$defs/NativeToken" }, { "type": "null" } ] },
        "receiver_epoch": { "$ref": "common.schema.json#/$defs/Epoch" },
        "menu_type": { "type": ["string", "null"], "maxLength": 96 },
        "kind": { "enum": ["none", "hud", "prose", "question", "choice", "shop", "container", "levelup",
                           "levelup_profession", "shipping", "readycheck", "text_entry", "minigame", "event",
                           "item_list", "unknown"] },
        "owned_by": { "oneOf": [
          { "type": "null" }, { "enum": ["native", "host"] },
          { "type": "object", "additionalProperties": false, "required": ["attempt_id", "request_id", "via"],
            "properties": { "attempt_id": { "$ref": "common.schema.json#/$defs/Id" },
                            "request_id": { "$ref": "common.schema.json#/$defs/Id" },
                            "via": { "enum": ["edge", "continuation"] } } } ] },
        "authority": { "type": "object", "additionalProperties": false, "required": ["holder", "since_frame"],
                       "properties": { "holder": { "enum": ["core", "progression", "none"] },
                                       "since_frame": { "$ref": "common.schema.json#/$defs/Frame" } } },
        "controls": { "type": "array", "maxItems": 256, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["control_id", "label", "role", "visible_rendered", "enabled", "order"],
          "properties": { "control_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                          "label": { "$ref": "common.schema.json#/$defs/Text80" },
                          "role": { "enum": ["ok", "cancel", "close", "response", "item_slot", "shop_row", "tab", "page_next",
                                             "page_prev", "scroll", "text_box", "profession", "button", "other"] },
                          "visible_rendered": { "type": "boolean" }, "enabled": { "type": "boolean" },
                          "order": { "type": "integer", "minimum": 0 },
                          "slot_ref": { "type": "object", "additionalProperties": false,
                                        "required": ["inv_slot", "item_id", "qty", "quality"],
                                        "properties": { "inv_slot": { "type": "integer", "minimum": 0 },
                                                        "item_id": { "type": "string", "maxLength": 96 },
                                                        "qty": { "type": "integer", "minimum": 0 },
                                                        "quality": { "enum": [0, 1, 2, 4] } } },
                          "price": { "type": "integer", "minimum": 0 },
                          "stock": { "type": "integer", "minimum": -1 } } } },
        "prompt_digest": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Sha256" }, { "type": "null" } ] },
        "options_digest": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Sha256" }, { "type": "null" } ] },
        "text": { "type": "array", "maxItems": 32, "items": { "$ref": "common.schema.json#/$defs/Text240" } },
        "text_loss": { "type": "boolean" },
        "page": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["index", "count"],
                  "properties": { "index": { "type": "integer", "minimum": 0 }, "count": { "type": "integer", "minimum": 1 } } } ] },
        "actionable": { "type": "boolean" },
        "levelup": { "type": "object", "additionalProperties": false, "required": ["skill", "level", "profession"],
                     "properties": { "skill": { "enum": ["farming", "fishing", "foraging", "mining", "combat", "luck"] },
                                     "level": { "type": "integer", "minimum": 1, "maximum": 10 },
                                     "profession": { "type": "boolean" } } },
        "stack": { "type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["receiver_id", "presence_id", "menu_type", "depth"],
          "properties": { "receiver_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                          "presence_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                          "menu_type": { "type": "string", "maxLength": 96 },
                          "depth": { "type": "integer", "minimum": 0 } } } },
        "parked": { "type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["receiver_id", "presence_id", "menu_type", "holder"],
          "properties": { "receiver_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                          "presence_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                          "menu_type": { "type": "string", "maxLength": 96 },
                          "holder": { "type": "string", "pattern": "^[A-Za-z0-9_.]{1,96}$" } } } } },
      "allOf": [ { "if": { "properties": { "kind": { "enum": ["levelup", "levelup_profession"] } } },
                   "then": { "required": ["levelup"] } } ] },
    "Native": { "type": "object", "additionalProperties": false,
      "required": ["control_taken", "progress_marker", "barrier", "night_plan", "nights", "debts", "journal", "active_attempt",
                   "input_idle", "halt", "rearmed", "halt_notes", "fenced_generation", "occurrences", "proposals", "window",
                   "draw"],
      "properties": {
        "control_taken": { "enum": [null, "fade", "warp", "event", "save", "minigame", "fishing", "cutscene"] },
        "progress_marker": { "type": "object", "additionalProperties": false, "required": ["kind", "value"],
                             "properties": { "kind": { "enum": ["none", "event_command", "fade_alpha", "save_progress", "minigame"] },
                                             "value": { "type": "integer" } } },
        "barrier": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
          "required": ["kind", "instance_id", "stage", "opened_frame", "opened_ms", "stage_since_ms", "decisions_served"],
          "properties": { "kind": { "$ref": "common.schema.json#/$defs/BarrierKind" },
                          "instance_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                          "stage": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
                          "stage_index": { "type": "integer", "minimum": 0 },
                          "opened_frame": { "$ref": "common.schema.json#/$defs/Frame" },
                          "opened_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
                          "stage_since_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
                          "decisions_served": { "type": "integer", "minimum": 0 } } } ] },
        "night_plan": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/NightPlan" } ] },
        "nights": { "type": "array", "maxItems": 17, "items": { "$ref": "#/$defs/Night" } },
        "debts": { "type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["debt_id", "kind", "opened_by", "allows", "since_ms"],
          "properties": { "debt_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                          "kind": { "$ref": "common.schema.json#/$defs/DebtKind" },
                          "opened_by": { "oneOf": [ { "enum": ["native", "peer"] },
                            { "type": "object", "additionalProperties": false, "required": ["attempt_id"],
                              "properties": { "attempt_id": { "$ref": "common.schema.json#/$defs/Id" } } } ] },
                          "allows": { "type": "array", "maxItems": 8, "items": { "$ref": "common.schema.json#/$defs/AllowedOp" } },
                          "object_ref": { "$ref": "common.schema.json#/$defs/NativeToken" },
                          "since_ms": { "$ref": "common.schema.json#/$defs/WallMs" } } } },
        "journal": { "type": "object", "additionalProperties": false, "required": ["unresolved", "cap"],
                     "properties": { "unresolved": { "type": "integer", "minimum": 0 }, "cap": { "type": "integer", "minimum": 1 } } },
        "active_attempt": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
          "required": ["attempt_id", "actor", "phase"],
          "properties": { "attempt_id": { "$ref": "common.schema.json#/$defs/Id" },
                          "actor": { "enum": ["model", "activity", "safety", "legacy", "progression"] },
                          "phase": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" } } } ] },
        "input_idle": { "$ref": "session.schema.json#/$defs/InputIdleSlots" },
        "halt": { "oneOf": [ { "type": "null" }, { "$ref": "session.schema.json#/$defs/HaltFact" } ] },
        "rearmed": { "oneOf": [ { "type": "null" }, { "$ref": "session.schema.json#/$defs/Rearmed" } ] },
        "halt_notes": { "$ref": "session.schema.json#/properties/halt_notes" },
        "fenced_generation": { "type": "integer", "minimum": 0 },
        "occurrences": { "type": "object", "additionalProperties": false, "required": ["first_seq", "last_seq", "tail"],
                         "properties": { "first_seq": { "type": "integer", "minimum": 0 },
                                         "last_seq": { "type": "integer", "minimum": 0 },
                                         "tail_truncated": { "type": "boolean" },
                                         "tail": { "type": "array", "maxItems": 16, "$comment": "≤ 16 records and ≤ 8 KiB (R0-03 §2)",
                                                   "items": { "$ref": "occurrence_ring.schema.json#/$defs/Record" } } } },
        "proposals": { "$comment": "R0-05 E11; CK-P/CK-I level fact", "type": "object", "additionalProperties": false,
                       "required": ["outgoing", "incoming"],
                       "properties": {
                         "outgoing": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/Proposal" } ] },
                         "incoming": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/Proposal" } ] },
                         "unreadable": { "type": "boolean" } } },
        "window": { "type": "object", "additionalProperties": false, "required": ["state"],
                    "properties": { "state": { "enum": ["visible_inactive", "focused", "minimized", "unknown"] } } },
        "draw": { "type": "object", "additionalProperties": false, "required": ["count", "last_ms"],
                  "properties": { "count": { "type": "integer", "minimum": 0 },
                                  "last_ms": { "$ref": "common.schema.json#/$defs/WallMs" } } } } },
    "NightPlan": { "type": "object", "additionalProperties": false, "required": ["night_id", "levelups", "shipping", "save"],
      "properties": { "night_id": { "$ref": "#/$defs/NightId" },
                      "levelups": { "type": "array", "maxItems": 12, "items": {
                        "type": "object", "additionalProperties": false, "required": ["skill", "level", "profession"],
                        "properties": { "skill": { "enum": ["farming", "fishing", "foraging", "mining", "combat", "luck"] },
                                        "level": { "type": "integer", "minimum": 1, "maximum": 10 },
                                        "profession": { "type": "boolean" } } } },
                      "shipping": { "type": "boolean" },
                      "save": { "enum": ["nested", "direct", "unknown"] } } },
    "Proposal": { "type": "object", "additionalProperties": false, "required": ["proposal_id", "type", "sender_id", "receiver_id"],
      "properties": { "proposal_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                      "type": { "enum": ["gift", "dance", "trade", "marriage", "other"] },
                      "sender_id": { "type": "integer" }, "receiver_id": { "type": "integer" },
                      "response": { "enum": [null, "accepted", "declined"] } } },
    "NightId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}\\|-?[0-9]{1,20}\\|[0-9]{1,4}-(spring|summer|fall|winter)-[0-9]{1,2}$" },
    "Night": { "type": "object", "additionalProperties": false,
      "required": ["night_id", "seq", "date", "state", "opened_by", "intent", "intent_cleared_by", "collapse", "day_events",
                   "plan", "save", "day_started_frame", "cause_hint"],
      "properties": {
        "night_id": { "$ref": "#/$defs/NightId" }, "seq": { "type": "integer", "minimum": 0 },
        "date": { "$ref": "common.schema.json#/$defs/GameDate" },
        "state": { "enum": ["pending", "committed"] },
        "opened_by": { "enum": ["day_started", "restart", "load", "reconnect"] },
        "intent": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false,
                    "required": ["frame", "attempt_id"],
                    "properties": { "frame": { "$ref": "common.schema.json#/$defs/Frame" },
                                    "attempt_id": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Id" }, { "type": "null" } ] } } } ] },
        "intent_cleared_by": { "enum": [null, "ready_cancel", "collapse", "save_failed", "reconnect"] },
        "collapse": { "enum": [null, "passout_0200", "exhaustion", "ko"] },
        "day_events": { "type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["kind", "frame", "recovered"],
          "properties": { "kind": { "enum": ["exhaustion", "ko"] }, "frame": { "$ref": "common.schema.json#/$defs/Frame" },
                          "recovered": { "const": true } } } },
        "plan": { "oneOf": [ { "$ref": "#/$defs/NightPlan" }, { "const": "unknown" }, { "type": "null" } ] },
        "save": { "enum": ["acknowledged", "unknown"] },
        "day_started_frame": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Frame" }, { "type": "null" } ] },
        "cause_hint": { "enum": [null, "restart_across_date", "lost_pending", "date_gap", "save_failed", "reconnect", "other"] } } }
  }
}
