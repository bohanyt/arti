{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arti:contracts/verb.schema.json",
  "type": "object", "additionalProperties": false, "required": ["verb", "args", "pins"],
  "properties": { "verb": { "$ref": "common.schema.json#/$defs/VerbName" }, "args": { "type": "object" },
                  "pins": { "$ref": "#/$defs/Pins" } },
  "oneOf": [
    { "properties": { "verb": { "const": "observe" }, "args": { "$ref": "#/$defs/Observe" } } },
    { "properties": { "verb": { "const": "move" }, "args": { "$ref": "#/$defs/Move" } } },
    { "properties": { "verb": { "const": "interact" }, "args": { "$ref": "#/$defs/Interact" } } },
    { "properties": { "verb": { "const": "use" }, "args": { "$ref": "#/$defs/Use" } } },
    { "properties": { "verb": { "const": "select" }, "args": { "$ref": "#/$defs/Select" } } },
    { "properties": { "verb": { "const": "ui" }, "args": { "$ref": "#/$defs/Ui" } } },
    { "properties": { "verb": { "const": "transfer" }, "args": { "$ref": "#/$defs/Transfer" } } },
    { "properties": { "verb": { "const": "run_controller" }, "args": { "$ref": "#/$defs/RunController" } } }
  ],
  "$defs": {
    "Hold": { "type": "integer", "minimum": 0, "maximum": 120 },
    "Slot": { "type": "integer", "minimum": 0, "maximum": 35 },
    "Observe": { "type": "object", "additionalProperties": false, "required": ["scope"],
      "properties": { "scope": { "enum": ["target", "surface", "location"] },
                      "target_id": { "$ref": "common.schema.json#/$defs/NativeToken" } },
      "if": { "properties": { "scope": { "const": "target" } } }, "then": { "required": ["target_id"] } },
    "Move": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["heading", "ticks"],
        "properties": { "heading": { "enum": ["n", "ne", "e", "se", "s", "sw", "w", "nw"] },
                        "ticks": { "type": "integer", "minimum": 1, "maximum": 60 } } },
      { "type": "object", "additionalProperties": false, "required": ["exit_id"],
        "properties": { "exit_id": { "$ref": "common.schema.json#/$defs/NativeToken" } } },
      { "type": "object", "additionalProperties": false, "required": ["target_id"],
        "properties": { "target_id": { "$ref": "common.schema.json#/$defs/NativeToken" } } } ] },
    "Interact": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["target_id"],
        "properties": { "target_id": { "$ref": "common.schema.json#/$defs/NativeToken" }, "hold_ticks": { "$ref": "#/$defs/Hold" } } },
      { "type": "object", "additionalProperties": false, "required": ["target"],
        "properties": { "target": { "const": "self" }, "hold_ticks": { "$ref": "#/$defs/Hold" } } } ] },
    "Use": { "type": "object", "additionalProperties": false, "required": ["slot"],
      "properties": { "target_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                      "tile": { "$ref": "common.schema.json#/$defs/Point" },
                      "slot": { "$ref": "#/$defs/Slot" }, "hold_ticks": { "$ref": "#/$defs/Hold" } },
      "oneOf": [ { "required": ["target_id"] }, { "required": ["tile"] } ] },
    "Select": { "type": "object", "additionalProperties": false, "required": ["slot"],
      "properties": { "slot": { "$ref": "#/$defs/Slot" } } },
    "Ui": { "type": "object", "additionalProperties": false, "required": ["receiver_id", "gesture"],
      "properties": { "receiver_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                      "control_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                      "gesture": { "enum": ["press_a", "press_b", "secondary", "scroll", "type", "close", "advance", "open_menu"] },
                      "notches": { "type": "integer", "minimum": -10, "maximum": 10, "not": { "const": 0 } },
                      "text": { "type": "string", "minLength": 1, "maxLength": 64 },
                      "hold_ticks": { "$ref": "#/$defs/Hold" } },
      "allOf": [
        { "if": { "properties": { "gesture": { "const": "scroll" } } }, "then": { "required": ["notches"] },
          "else": { "not": { "required": ["notches"] } } },
        { "if": { "properties": { "gesture": { "const": "type" } } }, "then": { "required": ["text"] },
          "else": { "not": { "required": ["text"] } } } ] },
    "Transfer": { "type": "object", "additionalProperties": false, "required": ["receiver_id", "from", "to", "qty"],
      "properties": { "receiver_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                      "from": { "type": "object", "additionalProperties": false, "required": ["area", "slot"],
                                "properties": { "area": { "enum": ["bag", "container", "shop"] },
                                                "slot": { "type": "integer", "minimum": 0, "maximum": 255 } } },
                      "to": { "type": "object", "additionalProperties": false, "required": ["area"],
                              "properties": { "area": { "enum": ["bag", "container", "shop", "ground"] } } },
                      "qty": { "enum": ["all", "one", "half"] } } },
    "RunController": { "type": "object", "additionalProperties": false, "required": ["kind", "budget_s"],
      "properties": { "kind": { "enum": ["fish", "combat", "charge"] },
                      "mode": { "enum": ["fight", "retreat"] },
                      "budget_s": { "type": "integer", "minimum": 1, "maximum": 120 },
                      "stop": { "type": "object", "additionalProperties": false,
                                "properties": { "hp_floor_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
                                                "max_catches": { "type": "integer", "minimum": 1, "maximum": 10 },
                                                "max_kills": { "type": "integer", "minimum": 1, "maximum": 50 },
                                                "power": { "type": "integer", "minimum": 1, "maximum": 5 } } } },
      "allOf": [ { "if": { "properties": { "kind": { "const": "combat" } } }, "then": { "required": ["mode"] },
                   "else": { "not": { "required": ["mode"] } } } ] },
    "Pins": { "type": "object", "additionalProperties": false,
      "required": ["session_id", "player_id", "location", "receiver_epoch", "row_key"],
      "properties": { "session_id": { "$ref": "common.schema.json#/$defs/Id" }, "player_id": { "type": "integer" },
                      "row_key": { "$ref": "verb_phases.schema.json#/$defs/RowKey",
                                   "$comment": "R0 round 2 SOL-B1(a): the one wire location of the selected T-CL row key (§4.3)" },
                      "location": { "$ref": "common.schema.json#/$defs/Text80" },
                      "receiver_epoch": { "$ref": "common.schema.json#/$defs/Epoch" },
                      "target_instance": { "$ref": "common.schema.json#/$defs/NativeToken" },
                      "control_order": { "type": "integer", "minimum": 0 },
                      "control_digest": { "$ref": "common.schema.json#/$defs/Sha256" },
                      "item_binding": { "$ref": "common.schema.json#/$defs/ItemRef" },
                      "tool_binding": { "$ref": "common.schema.json#/$defs/NativeToken" },
                      "controller_kind": { "enum": ["fish", "combat", "charge"] } } }
  }
}
