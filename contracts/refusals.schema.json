{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arti:contracts/refusals.schema.json",
  "type": "object", "additionalProperties": false, "required": ["v", "codes", "cancel_reasons", "native_map", "default"],
  "properties": {
    "v": { "const": "arti.refusals/1" },
    "codes": { "type": "object", "additionalProperties": false,
               "patternProperties": { "^[a-z_]+$": { "$ref": "#/$defs/Entry" } } },
    "cancel_reasons": { "type": "object", "additionalProperties": false,
                        "patternProperties": { "^[a-z_]+$": { "$ref": "#/$defs/Single" } } },
    "native_map": { "type": "object", "additionalProperties": { "oneOf": [ { "$ref": "#/$defs/Code" },
                    { "const": "not_a_refusal" } ] } },
    "default": { "const": "defect-unclassified" }
  },
  "$defs": {
    "Code": { "enum": ["game_refusal", "debt_active", "premotor_busy", "backend_undeliverable", "interrupted_before_edge",
                       "latch_unreachable", "focus_lost", "seat_unavailable", "not_admitted_deadline", "offer_stale",
                       "binding_changed", "precondition_stale", "authority_not_core", "authority_busy", "claim_stale_epoch",
                       "generation_fenced", "lease_expired", "stale_control_seq", "journal_uncertain", "journal_capacity",
                       "stop_latched", "adapter_unimplemented", "adapter_unmapped_form", "adapter_unsupported_capability",
                       "adapter_malformed", "not_published", "withdrawn", "stopped", "identity", "cancelled",
                       "refusal_fact_mismatch"] },
    "CancelReason": { "enum": ["hazard", "owner_stop", "interrupt", "supersede", "deadline", "shutdown"] },
    "Single": { "type": "object", "additionalProperties": false, "required": ["bucket"],
      "properties": { "bucket": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Bucket" }, { "const": "cited_hazard" } ] },
                      "if_fact": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$",
                                   "$comment": "SPEC-Q ADR-15 item 1: R0-07 §13.1 had ^[a-z_]+$, which rejects §13.2's own handoff_within_2s; aligned with the Facts key pattern" },
                      "else_bucket": { "$ref": "common.schema.json#/$defs/Bucket" },
                      "requires_citation": { "enum": ["hazard_record", "arriving_receiver_id"] } } },
    "Rate": { "type": "object", "additionalProperties": false, "required": ["scope", "n", "window_s", "bucket"],
      "properties": { "scope": { "enum": ["code", "code_target", "class", "debt_age", "target_e0", "cause",
                                          "activity_consecutive", "acquire_after_halt", "no_completed_between"] },
                      "n": { "type": "integer", "minimum": 1 }, "window_s": { "type": "integer", "minimum": 0 },
                      "bucket": { "$ref": "common.schema.json#/$defs/Bucket" },
                      "one_per_window": { "type": "boolean" },
                      "filter": { "type": "string", "pattern": "^[a-z_=:|]+$" } } },
    "Entry": { "type": "object", "additionalProperties": false, "required": ["class", "precondition", "single", "rates"],
      "properties": { "class": { "enum": ["game", "own_debt", "foreign_debt", "backend", "staleness", "authority", "halt",
                                          "adapter", "abort", "control", "integrity"] },
                      "class_by": { "const": "debt.opened_by" },
                      "precondition": { "type": "string", "maxLength": 200 },
                      "single": { "$ref": "#/$defs/Single" },
                      "rates": { "type": "array", "items": { "$ref": "#/$defs/Rate" } } } }
  }
}
