{ "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "arti:contracts/journal_vocab.schema.json",
  "$comment": "R0-07 §9.2 closed ev list. $defs/Ev is referenced by journal.schema.json; the instance shape (ev -> group, required facts, bucket) is the C0 packaging of the §9.2 table",
  "type": "object", "additionalProperties": false, "required": ["v", "evs"],
  "properties": { "v": { "const": "arti.journal_vocab/1" },
    "evs": { "type": "object", "propertyNames": { "$ref": "#/$defs/Ev" },
             "additionalProperties": { "$ref": "#/$defs/Entry" } } },
  "$defs": {
    "Ev": { "enum": [
      "core_start", "restart_step", "core_stop", "run_closed", "wall_clock_step", "prev_exit_unknown",
      "loop_state", "settle_unclassified", "identity_resync", "identity_change", "tick_overrun",
      "attempt_recorded", "acquire_requested", "acquired", "published", "admitted", "release_requested", "released",
      "attempt_aborted", "request_withdrawn", "cancel_requested", "cancel_stale", "cancel_no_active", "result_seen",
      "result_deadline", "release_unproven", "lease_release_unacked",
      "status_query", "status_answer", "fence_sent", "fence_acked", "fence_failed", "claim_sent", "claim_answer",
      "whitelist_disagreement", "authority_moved",
      "evidence_provisional", "attempt_final", "effect_booked", "effect_corroborated", "late_effect_after_final",
      "late_observed_after_closure", "late_witness_after_closure", "late_witness_after_e3", "quarantine_set",
      "quarantine_released", "epoch_adopted", "foreign_epoch", "pending_evidence_full", "pending_evidence_exhausted",
      "pending_evidence_reopened", "capacity_relief", "capacity_status_probe", "pe_over_capacity",
      "refusal", "fault", "producer_bucket_ignored", "refusal_fact_mismatch", "journal_reject",
      "offer_built", "decision_pending", "decision_reply_selected", "decision_dispatched", "decision_resolved",
      "decision_retired", "decision_reply_voided", "decision_reply_late", "superseded", "invalid_model_choice",
      "answer_ineffective", "answer_class_unmapped", "decision_alert", "decision_unanswered", "intent_line",
      "provider_call", "provider_answer", "provider_error", "provider_probe", "provider_breaker", "provider_call_abandoned",
      "provider_late_completion", "provider_call_leaked", "provider_deferred", "provider_budget", "budget_ledger_mismatch",
      "provider_spend_report", "client_setup_ms",
      "hazard", "assert_stop", "stop_written", "stop_write_failed", "h1_retreat_start", "h1_retreat_unavailable",
      "halt_observed", "rearmed", "halt_record_missing", "stop_identity_mismatch", "no_progress_warning", "oscillation",
      "core_restarted", "startup_wait_mod", "record_unreadable", "accounting_torn_tail", "request_unparseable",
      "occurrence_read_retry", "proposal_fact_unreadable", "effect_not_credited", "effect_credited_twice",
      "operator_intervention", "apparatus", "spend_committed", "spend_failed",
      "barrier_opened", "barrier_stage", "barrier_closed", "barrier_exceeded", "night_plan", "night_plan_mismatch",
      "night_committed", "day_rolled", "day_event", "release_unproven_resolved",
      "occurrence_read", "occurrence_gap", "outbox_gap", "outbox_commit", "projection_lag", "spill_merged",
      "io_retry", "durable_io_degraded", "durable_io_recovered",
      "host_status_seen", "host_reply", "host_stop", "host_telemetry_lost",
      "ct_alert" ] },
    "Entry": { "type": "object", "additionalProperties": false, "required": ["group", "required_facts", "bucket"],
      "properties": {
        "group": { "enum": ["process", "loop", "executor", "control", "ledger", "refusal_fault", "decision", "provider", "safety",
                            "r0_integration", "barrier_night", "occurrence_outbox", "durability", "host", "watcher"] },
        "required_facts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" } },
        "one_of_facts": { "type": "array", "minItems": 2, "uniqueItems": true,
                          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                          "$comment": "exactly one of these keys must be present (release_unproven)" },
        "bucket": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Bucket" }, { "enum": ["registry", "see_note"] } ],
                    "$comment": "registry = faults.py derives it from code (§6.1, §13); see_note = conditional or non-bucket cell" },
        "bucket_note": { "type": "string", "maxLength": 160 } },
      "allOf": [ { "if": { "properties": { "bucket": { "const": "see_note" } } }, "then": { "required": ["bucket_note"] } } ] }
  } }
