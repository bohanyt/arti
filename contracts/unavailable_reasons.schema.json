{ "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "arti:contracts/unavailable_reasons.schema.json",
  "$comment": "R0-07 §3.4. $defs/Code verbatim; the instance shape (code -> fixed text + source rule) is the C0 packaging of the §3.4 table",
  "type": "object", "additionalProperties": false, "required": ["v", "codes"],
  "properties": { "v": { "const": "arti.unavailable_reasons/1" },
    "codes": { "type": "object",
      "required": ["handoff_pending", "target_fenced", "target_quarantined", "buried", "debt_disallows", "foreign_debt",
                   "not_actionable", "durable_io_degraded", "pending_evidence_full", "pending_evidence_exhausted",
                   "capability_unsupported"],
      "propertyNames": { "$ref": "#/$defs/Code" },
      "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["text", "source"],
        "properties": { "text": { "$ref": "common.schema.json#/$defs/Text80" },
                        "source": { "type": "string", "maxLength": 120 } } } } },
  "$defs": { "Code": { "enum": ["handoff_pending", "target_fenced", "target_quarantined", "buried", "debt_disallows",
                                "foreign_debt", "not_actionable", "durable_io_degraded", "pending_evidence_full",
                                "pending_evidence_exhausted", "capability_unsupported"] } } }
