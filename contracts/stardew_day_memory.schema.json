{ "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "arti:contracts/stardew_day_memory.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "date", "effects", "places", "unfinished_intents", "chests"],
  "properties": {
    "schema": { "const": "arti.stardew_day_memory/1" },
    "date": { "$ref": "stardew_state.schema.json#/properties/date" },
    "effects": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "places": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
    "unfinished_intents": { "type": "array", "items": { "type": "string", "maxLength": 240 } },
    "chests": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Chest" } } },
  "$defs": {
    "Chest": { "type": "object", "additionalProperties": false, "required": ["items", "game_time"],
               "properties": { "items": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
                               "game_time": { "type": "string", "maxLength": 32 } } },
    "Yesterday": { "type": "object", "additionalProperties": false,
      "required": ["schema", "date", "effects", "places", "unfinished_intents", "chests", "verified_effects"],
      "properties": { "schema": { "const": "arti.stardew_day_memory/1" },
                      "date": { "$ref": "stardew_state.schema.json#/properties/date" },
                      "effects": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
                      "places": { "type": "array", "items": { "type": "string" } },
                      "unfinished_intents": { "type": "array", "items": { "type": "string" } },
                      "verified_effects": { "type": "array", "items": { "type": "string", "pattern": "^Sudah tercatat " } },
                      "chests": { "type": "object", "properties": { "summary": { "type": "array", "items": { "type": "string" } } },
                                  "additionalProperties": { "$ref": "#/$defs/Chest" } } } } } }
