{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arti:contracts/accounting.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["v", "seq", "ts_ms", "run_id", "session_id", "kind", "occurrence_id", "source_id", "occurrence_index"],
  "properties": {
    "v": { "const": "arti.accounting/1" },
    "seq": { "type": "integer", "minimum": 1 },
    "ts_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
    "run_id": { "$ref": "common.schema.json#/$defs/Id" },
    "session_id": { "type": ["string", "null"], "maxLength": 128 },
    "kind": { "enum": ["attempt_final", "late_key", "quarantine_released", "decision", "night", "occurrence",
                       "occurrence_gap", "outbox", "reconcile", "outbox_gap", "halt", "rearmed", "run_closed"] },
    "occurrence_id": { "$ref": "common.schema.json#/$defs/Sha256" },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "occurrence_index": { "oneOf": [ { "type": "integer", "minimum": 0 },
      { "type": "array", "prefixItems": [ { "type": "integer", "minimum": 1 },
          { "enum": ["pending", "reply_selected", "reply_voided", "dispatched", "resolved", "retired"] } ],
        "items": false, "minItems": 2 },
      { "$ref": "common.schema.json#/$defs/EffectKey" } ] },
    "attempt_id": { "$ref": "common.schema.json#/$defs/Id" },
    "decision_id": { "$ref": "common.schema.json#/$defs/Sha256" },
    "occurrence_no": { "type": "integer", "minimum": 1 },
    "generation": { "$ref": "common.schema.json#/$defs/Gen" },
    "decision_state": { "enum": ["pending", "reply_selected", "reply_voided", "dispatched", "resolved", "retired"] },
    "lane": { "enum": ["force", "in_menu", "activity"] },
    "first_seen_wall_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
    "cause": { "enum": ["open", "e0", "ineffective", "answer_uncertain", "navigation", "edit", "superseded", "resurfaced",
                        "restart", "reply_voided", "capacity", "not_actionable", "actionable", "lane_change"] },
    "prev_attempt_id": { "$ref": "common.schema.json#/$defs/Id" },
    "choice": { "type": "string", "pattern": "^c([1-9]|1[0-9]|2[0-4])$" },
    "activity_id": { "$ref": "common.schema.json#/$defs/Id" },
    "runtime_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
    "receiver_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
    "presence_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
    "semantic_id": { "$ref": "#/$defs/SemanticId" },
    "receiver_state": { "enum": ["live", "buried", "vanished"] },
    "own_successor": { "type": "boolean", "$comment": "true = the running activity/reflex answers it (B2); ARTI gets no offer" },
    "na": { "type": "object", "additionalProperties": false, "required": ["reason", "since_wall_ms"],
            "$comment": "open not-actionable interval at this generation (R0-01 §6); absent = actionable",
            "properties": { "reason": { "enum": ["ui_not_actionable", "debt_blocked", "class_closed", "buried"] },
                            "since_wall_ms": { "$ref": "common.schema.json#/$defs/WallMs" } } },
    "inherits": { "type": "object", "additionalProperties": false, "required": ["decision_id", "vanished_wall_ms"],
                  "$comment": "semantic age inheritance (spec §6.5, 10 s wall window); first_seen_wall_ms is copied from it",
                  "properties": { "decision_id": { "$ref": "common.schema.json#/$defs/Sha256" },
                                  "vanished_wall_ms": { "$ref": "common.schema.json#/$defs/WallMs" } } },
    "age_root": { "$ref": "common.schema.json#/$defs/Sha256",
                  "$comment": "decision_id whose first_seen started this clock (own decision_id unless inherited)" },
    "vanished_wall_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
    "save_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
    "player_id": { "type": "integer", "$comment": "same integer identity as observation identity.player_id and pins (CONF-NB)" },
    "activity_seq": { "type": "integer", "minimum": 1 },
    "choice_kind": { "enum": ["activity", "resume", "wait"] },
    "activity_binding": { "type": "object", "additionalProperties": false, "required": ["name", "args"],
                          "$comment": "CONF-1 durable activity_id -> composition binding; written with the resolved choice",
                          "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
                                          "args": { "$ref": "common.schema.json#/$defs/Facts" } } },
    "via": { "enum": ["answer_witness", "effect_final", "late_answer_witness", "choice", "uncertain_receiver_gone"] },
    "uncertain": { "type": "boolean" },
    "witness_ref": { "type": "object", "additionalProperties": false, "required": ["source", "kind", "frame", "runtime_id"],
                     "$comment": "runtime-qualified anchor; ordered by T-ORD (R0-05 §1); tick required when source = ring",
                     "properties": { "source": { "enum": ["result", "ring"] },
                                     "kind": { "type": "string", "maxLength": 40 },
                                     "frame": { "$ref": "common.schema.json#/$defs/Frame" },
                                     "tick": { "$ref": "common.schema.json#/$defs/Tick" },
                                     "runtime_id": { "$ref": "common.schema.json#/$defs/NativeToken" },
                                     "occ_seq": { "type": "integer", "minimum": 1 } } },
    "resolved_wall_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
    "retire_reason": { "enum": ["vanished", "native_resolved", "host_withdrawn", "authority_moved"] },
    "during_restart": { "type": "boolean" },
    "void_reason": { "const": "restart_before_record" },
    "late_class": { "enum": ["late_effect_after_final", "late_observed_after_closure", "late_witness_after_closure",
                             "late_witness_after_e3", "adopted"] },
    "adopts": { "$ref": "common.schema.json#/$defs/Sha256", "$comment": "K1 id of the null-frame key adopted (R0-06 AP-11)" },
    "h5_arrival_ms": { "oneOf": [ { "$ref": "common.schema.json#/$defs/WallMs" }, { "type": "null" } ] },
    "release_via": { "enum": ["closure_observed", "idempotent", "night", "runtime_change"] },
    "closure_frame": { "$ref": "common.schema.json#/$defs/Frame" },
    "closure_runtime_id": { "$ref": "common.schema.json#/$defs/NativeToken", "$comment": "T-ORD anchor runtime (R0-05 §1)" },
    "observation_frame": { "$ref": "common.schema.json#/$defs/Frame" },
    "observation_runtime_id": { "$ref": "common.schema.json#/$defs/NativeToken", "$comment": "T-ORD anchor runtime" },
    "night_id": { "$ref": "observation.schema.json#/$defs/NightId" },
    "night_label": { "enum": ["slept", "passed_out", "unknown"] },
    "occ_seq": { "type": "integer", "minimum": 1 },
    "occ_cursor": { "type": "integer", "minimum": 0 },
    "evidence": { "$ref": "#/$defs/Evidence" },
    "deltas": { "type": "array", "maxItems": 32, "items": { "$ref": "common.schema.json#/$defs/Facts" } },
    "event": { "type": "object" },
    "halt": { "$comment": "R0-03 §2 accounting halt/rearmed fields", "type": "object", "additionalProperties": false,
              "required": ["stop_id", "cause", "scope"],
              "properties": { "halt_event": { "enum": ["asserted", "observed", "mirrored", "reasserted", "escalated", "discharged"] },
                              "evidence": { "$comment": "only on discharged (R0-03 §2 Assertion lifecycle)", "enum": ["rearmed", "archived"] },
                              "episode_id": { "$ref": "common.schema.json#/$defs/Id" },
                              "halt_seq": { "type": "integer", "minimum": 1 },
                              "stop_id": { "$ref": "common.schema.json#/$defs/Id" },
                              "stop_ids": { "type": "array", "maxItems": 16, "items": { "$ref": "common.schema.json#/$defs/Id" } },
                              "cause": { "$ref": "common.schema.json#/$defs/StopCause" },
                              "scope": { "$ref": "common.schema.json#/$defs/StopScope" },
                              "created": { "type": "boolean" },
                              "actor": { "enum": ["owner", "rig_operator"] } } },
    "gap": { "type": "object", "additionalProperties": false,
             "properties": { "from_seq": { "type": "integer" }, "to_seq": { "type": "integer" },
                             "prev_run_id": { "$ref": "common.schema.json#/$defs/Id" },
                             "last_committed_seq": { "type": "integer" }, "last_committed_ts": { "type": "integer" } } }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "decision" } } },
      "then": { "required": ["decision_id", "occurrence_no", "generation", "decision_state", "lane", "first_seen_wall_ms",
                             "age_root"],
                "properties": { "occurrence_index": { "type": "array" } } } },
    { "if": { "properties": { "kind": { "const": "decision" }, "lane": { "enum": ["force", "in_menu"] } }, "required": ["lane"] },
      "then": { "required": ["runtime_id", "receiver_id", "presence_id", "semantic_id", "receiver_state", "own_successor"],
                "not": { "anyOf": [ { "required": ["activity_seq"] }, { "required": ["choice_kind"] },
                                    { "required": ["activity_binding"] } ] } } },
    { "if": { "properties": { "kind": { "const": "decision" }, "lane": { "const": "activity" } }, "required": ["lane"] },
      "then": { "required": ["save_id", "player_id", "activity_seq"],
                "not": { "anyOf": [ { "required": ["receiver_id"] }, { "required": ["own_successor"] } ] } } },
    { "if": { "properties": { "kind": { "const": "decision" }, "lane": { "const": "force" } }, "required": ["lane"] },
      "then": { "properties": { "own_successor": { "const": false } } } },
    { "if": { "properties": { "kind": { "const": "decision" }, "decision_state": { "const": "resolved" } } },
      "then": { "required": ["via", "uncertain", "resolved_wall_ms"] } },
    { "if": { "properties": { "kind": { "const": "decision" }, "decision_state": { "const": "resolved" },
                              "uncertain": { "const": true } }, "required": ["uncertain"] },
      "then": { "required": ["attempt_id"], "properties": { "via": { "const": "uncertain_receiver_gone" } },
                "not": { "required": ["witness_ref"] } },
      "else": { "properties": { "via": { "not": { "const": "uncertain_receiver_gone" } } } } },
    { "if": { "properties": { "kind": { "const": "decision" }, "decision_state": { "const": "resolved" },
                              "lane": { "const": "activity" } }, "required": ["lane"] },
      "then": { "required": ["choice", "choice_kind"], "properties": { "via": { "const": "choice" } } } },
    { "if": { "properties": { "kind": { "const": "decision" }, "choice_kind": { "enum": ["activity", "resume"] } },
              "required": ["choice_kind"] },
      "then": { "required": ["activity_id", "activity_binding"],
                "properties": { "activity_id": { "pattern": "^act[1-9][0-9]*$" } } } },
    { "if": { "properties": { "kind": { "const": "decision" }, "choice_kind": { "const": "wait" } }, "required": ["choice_kind"] },
      "then": { "not": { "anyOf": [ { "required": ["activity_id"] }, { "required": ["activity_binding"] } ] } } },
    { "if": { "properties": { "kind": { "const": "decision" } }, "not": { "required": ["choice_kind"] } },
      "then": { "not": { "required": ["activity_binding"] } } },
    { "if": { "properties": { "kind": { "const": "decision" }, "decision_state": { "const": "retired" } } },
      "then": { "required": ["retire_reason"] } },
    { "if": { "properties": { "kind": { "const": "decision" }, "retire_reason": { "const": "vanished" } },
              "required": ["retire_reason"] },
      "then": { "required": ["vanished_wall_ms"], "properties": { "receiver_state": { "const": "vanished" } } } },
    { "if": { "properties": { "kind": { "const": "decision" }, "decision_state": { "const": "reply_voided" } } },
      "then": { "required": ["void_reason"] } },
    { "if": { "properties": { "kind": { "const": "decision" }, "decision_state": { "const": "pending" } } },
      "then": { "required": ["cause"] } },
    { "if": { "properties": { "kind": { "const": "attempt_final" } } },
      "then": { "required": ["attempt_id", "evidence"], "properties": { "occurrence_index": { "type": "integer" } } } },
    { "if": { "properties": { "kind": { "const": "late_key" } } },
      "then": { "required": ["attempt_id", "late_class", "h5_arrival_ms"],
                "properties": { "occurrence_index": { "type": "object" } } } },
    { "if": { "properties": { "kind": { "const": "quarantine_released" } } },
      "then": { "required": ["attempt_id", "release_via"], "properties": { "occurrence_index": { "const": 0 } } } },
    { "if": { "properties": { "kind": { "const": "quarantine_released" }, "release_via": { "const": "closure_observed" } },
              "required": ["release_via"] },
      "then": { "required": ["closure_frame", "closure_runtime_id", "observation_frame", "observation_runtime_id"] } },
    { "if": { "properties": { "kind": { "const": "night" } } }, "then": { "required": ["night_id", "night_label"] } },
    { "if": { "properties": { "kind": { "const": "occurrence" } } }, "then": { "required": ["occ_seq", "occ_cursor"] } },
    { "if": { "properties": { "kind": { "enum": ["occurrence_gap", "outbox_gap"] } } }, "then": { "required": ["gap"] } },
    { "if": { "properties": { "kind": { "enum": ["halt", "rearmed"] } } }, "then": { "required": ["halt"] } }
  ],
  "$defs": { "Evidence": { "$comment": "accounting.schema.json $defs/Evidence (verbatim)",
               "type": "object", "additionalProperties": false,
               "required": ["value", "stage", "reason", "outcome", "effect_keys", "closure", "quarantined", "settle_at_final", "final_via",
                            "released_ms", "final_ms"],
               "properties": {
                 "value": { "$ref": "common.schema.json#/$defs/EValue" },
                 "stage": { "const": "final" },
                 "reason": { "oneOf": [ { "$ref": "refusals.schema.json#/$defs/Code" }, { "type": "null" } ] },
                 "outcome": { "$ref": "common.schema.json#/$defs/Outcome" },
                 "effect_keys": { "type": "array", "maxItems": 32, "items": { "type": "object", "additionalProperties": false,
                   "required": ["key", "source", "h5_arrival_ms", "productive"],
                   "properties": { "key": { "$ref": "common.schema.json#/$defs/EffectKey" },
                                   "source": { "enum": ["result", "ring", "snapshot"] },
                                   "h5_arrival_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
                                   "productive": { "type": "boolean" },
                                   "adopted_from_snapshot": { "type": "boolean" } } } },
                 "closure": { "$ref": "verb_result.schema.json#/properties/closure" },
                 "quarantined": { "type": "boolean" },
                 "quarantine_keys": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 200 } },
                 "settle_at_final": { "$ref": "common.schema.json#/$defs/SettleClass" },
                 "final_via": { "enum": ["not_executed", "normal", "status_answer", "absolute_bound", "capacity_relief"] },
                 "e4_cause": { "enum": ["status_nonsettled", "attribution_ambiguous", "closure_unproven", "readback_incomplete",
                                        "async_open", "debt_open", "barrier_open", "witness_without_predicate", "e4_unclassified"],
                               "$comment": "listed in R0-06 AP-21 evaluation order (defect causes first)" },
                 "released_ms": { "oneOf": [ { "$ref": "common.schema.json#/$defs/WallMs" }, { "type": "null" } ] },
                 "final_ms": { "$ref": "common.schema.json#/$defs/WallMs" }
               },
               "allOf": [
                 { "if": { "properties": { "value": { "const": "E4" } } }, "then": { "required": ["e4_cause"] },
                   "else": { "not": { "required": ["e4_cause"] } } },
                 { "if": { "properties": { "value": { "const": "E1" } } }, "then": false },
                 { "if": { "properties": { "value": { "const": "E0" } } }, "then": { "properties": { "reason": { "type": "string" },
                     "outcome": { "enum": ["NOT_EXECUTED", "PRECONDITION", "SAFETY_STOP"] } } } },
                 { "if": { "properties": { "value": { "const": "E3" } } }, "then": { "properties": { "closure": { "properties": {
                     "closed": { "const": true } } }, "effect_keys": { "maxItems": 0 } } } }
               ] },
             "SemanticId": { "type": "object", "additionalProperties": false,
                             "required": ["receiver_class", "prompt_digest", "options_digest"],
                             "$comment": "spec §6.5 semantic_id; equality = all three equal (C8 canonical JSON)",
                             "properties": { "receiver_class": { "type": "string", "maxLength": 96 },
                                             "prompt_digest": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Sha256" }, { "type": "null" } ] },
                                             "options_digest": { "oneOf": [ { "$ref": "common.schema.json#/$defs/Sha256" }, { "type": "null" } ] } } } }
}
