{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arti:contracts/spend.schema.json",
  "$comment": "R0-04 §9.2 arti.spend/1 (authoritative there); one record per line of spend/<account_tag>/<YYYY-MM>.jsonl. price_ref value types: # SPEC-Q ADR-15 item 8",
  "type": "object", "additionalProperties": false,
  "required": ["v", "seq", "ts_ms", "period", "account_tag", "provider", "model", "session_id", "run_id", "call_id", "kind", "usd",
               "price_ref"],
  "properties": {
    "v": { "const": "arti.spend/1" },
    "seq": { "type": "integer", "minimum": 1 },
    "ts_ms": { "$ref": "common.schema.json#/$defs/WallMs" },
    "period": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
    "account_tag": { "$ref": "common.schema.json#/$defs/Id" },
    "provider": { "const": "claude" },
    "model": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "astra" } },
    "session_id": { "$ref": "common.schema.json#/$defs/Id" },
    "run_id": { "$ref": "common.schema.json#/$defs/Id" },
    "call_id": { "type": "string", "pattern": "^[A-Za-z0-9._/|-]{1,128}:[0-9]+$", "$comment": "run_id:call_seq, unique across restarts" },
    "kind": { "enum": ["reserve", "settle"] },
    "usd": { "$ref": "#/$defs/Decimal" },
    "basis": { "enum": ["usage", "error_unbilled", "not_started", "assumed_no_usage", "assumed_restart"] },
    "w_usd": { "$ref": "#/$defs/Decimal" },
    "usage": { "type": "object", "additionalProperties": false,
               "required": ["input_tokens", "output_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"],
               "properties": { "input_tokens": { "type": "integer", "minimum": 0 },
                               "output_tokens": { "type": "integer", "minimum": 0 },
                               "cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
                               "cache_read_input_tokens": { "type": "integer", "minimum": 0 } } },
    "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
    "price_ref": { "type": "object", "additionalProperties": false, "required": ["in_usd_per_mtok", "out_usd_per_mtok", "price_asof"],
                   "properties": { "in_usd_per_mtok": { "$ref": "#/$defs/Decimal" },
                                   "out_usd_per_mtok": { "$ref": "#/$defs/Decimal" },
                                   "price_asof": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } } }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "reserve" } } },
      "then": { "required": ["w_usd"], "not": { "required": ["basis"] } } },
    { "if": { "properties": { "kind": { "const": "settle" } } },
      "then": { "required": ["basis"], "not": { "required": ["w_usd"] } } }
  ],
  "$defs": { "Decimal": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" } }
}
