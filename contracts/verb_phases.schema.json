{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arti:contracts/verb_phases.schema.json",
  "type": "object", "additionalProperties": false, "required": ["v", "verbs"],
  "properties": {
    "v": { "const": "arti.verb_phases/1" },
    "verbs": { "type": "object", "additionalProperties": false,
      "patternProperties": { "^(observe|move|interact|use|select|ui|transfer|run_controller)$": {
        "type": "object", "additionalProperties": false, "required": ["targets"],
        "properties": { "targets": { "type": "object", "minProperties": 1,
                          "propertyNames": { "$ref": "#/$defs/RowKey" },
                          "additionalProperties": { "$ref": "#/$defs/Row" } },
                        "controller_phases": { "type": "object",
                          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/Phase" } } } } } } }
  },
  "$defs": {
    "TargetKind": { "$comment": "closed T-CL target-kind enum (R0-05 §4.3); also observation world.targets[].kind",
                    "enum": ["hud", "slot", "tile", "crop", "forage", "debris", "dropped_item", "machine", "chest",
                             "shipping_bin", "shop_counter", "npc", "farmer", "door_warp", "bed", "self", "animal",
                             "other_world_object"] },
    "RowKey": { "$comment": "R0-05 §4.3/§4.3a: <target kind | any | receiver>[.<discriminator>]",
                "type": "string",
                "pattern": "^(any|receiver|hud|slot|tile|crop|forage|debris|dropped_item|machine|chest|shipping_bin|shop_counter|npc|farmer|door_warp|bed|self|animal|other_world_object)(\\.(held_tool|held_placeable|held_giftable|hand_empty|role:[a-z_]{1,32}|callback:[a-z_]{1,32}|arg:(heading|exit_id|target_id|bed)|controller:(fish|combat|charge)))?$" },
    "PossibleDelta": { "$comment": "closed union of the T-CL classes (R0-05 §4.3a); attempt_record.possible_delta uses it",
                       "enum": ["none", "held", "pose", "location", "receiver", "inventory", "world_target", "friendship",
                                "stamina", "hp", "drops", "intent", "profession", "proposal", "quest", "text",
                                "wallet_witness", "shop_stock", "container", "ground"] },
    "FenceClass": { "$comment": "R0-05 §4.3a; key grammar <fence_class>|<target_instance> (§6)",
                    "enum": ["none", "interact", "use_tool", "use_place", "ui_answer", "ui:proposal_send",
                             "ui:proposal_answer", "ui:shop", "transfer", "controller"] },
    "EffectKind": { "enum": ["pose_moved", "warp", "receiver_opened", "receiver_closed", "item_picked", "target_changed",
                             "target_removed", "held_changed", "control_changed", "text_readback", "item_moved", "sold",
                             "bought", "item_placed", "caught", "killed", "retreated", "power_reached", "proposal_sent",
                             "observed_day_change", "ok_accepted", "profession_selected", "page_advanced"] },
    "ClosureWitness": { "$comment": "R0-05 §4.1 closure kinds + the implied/idempotent reasons (R0-05 T-IMP)",
                        "enum": ["CK-R", "CK-B", "CK-D", "CK-T", "CK-W", "CK-C", "CK-P", "CK-I",
                                 "implied_night", "implied_runtime", "implied_fence", "idempotent"] },
    "Marker": { "enum": ["M-P", "M-D", "M-W", "M-T"] },
    "Phase": { "type": "object", "additionalProperties": false, "required": ["name", "validity"],
      "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
                      "validity": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
                      "adopts": { "type": "object", "additionalProperties": false, "required": ["receiver", "authentication"],
                        "properties": { "receiver": { "type": "string", "maxLength": 96 },
                                        "authentication": { "enum": ["own_edge_window", "controller_continuation", "hud_after_close"] } } } } },
    "Row": { "type": "object", "additionalProperties": false,
      "required": ["required_pins", "phases", "effect_kinds", "possible_delta", "closure", "idempotent", "successors", "async",
                   "mutating", "fence_class", "horizon_ms", "d3"],
      "properties": { "required_pins": { "type": "array", "uniqueItems": true, "items": { "enum": ["target_instance", "control_order",
                        "control_digest", "item_binding", "tool_binding", "controller_kind"] } },
                      "phases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Phase" } },
                      "effect_kinds": { "type": "array", "items": { "$ref": "#/$defs/EffectKind" } },
                      "event_kind": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" } },
                      "possible_delta": { "type": "array", "minItems": 1, "uniqueItems": true,
                                          "items": { "$ref": "#/$defs/PossibleDelta" } },
                      "mutating": { "type": "boolean" },
                      "fence_class": { "$ref": "#/$defs/FenceClass" },
                      "h2_sensitive_if": { "enum": ["container_nonempty"] },
                      "d3": { "type": "string", "pattern": "^(fixed:[0-9]+|ticks_plus:[0-9]+|hold_plus:[0-9]+|budget_plus:[0-9]+)$",
                              "$comment": "R0-05 T-DL DL-W3 in ms: fixed:4500, ticks_plus:2000 (move), hold_plus:3000 (use), budget_plus:40000" },
                      "closure": { "type": "array", "minItems": 1, "uniqueItems": true,
                                   "items": { "enum": ["CK-R", "CK-B", "CK-D", "CK-T", "CK-W", "CK-C", "CK-P", "CK-I"] } },
                      "markers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Marker" } },
                      "horizon_ms": { "type": "integer", "minimum": 0 },
                      "idempotent": { "type": "boolean" },
                      "successors": { "oneOf": [ { "type": "null" },
                                                 { "type": "string", "pattern": "^successors\\.json#/[A-Za-z0-9_./:|-]+$" } ] },
                      "async": { "type": "boolean" } } }
  }
}
