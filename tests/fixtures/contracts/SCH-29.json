  "cases": [
    { "name": "published_file", "contract": "progression_whitelist.json", "expect": "valid" },
    { "name": "sixth_entry_f", "contract": "progression_whitelist.json", "expect": "invalid",
      "ops": [ { "op": "set", "path": "/entries/-", "value": { "entry": "f", "menu_type": "QuestLog", "op": "b_info_ok", "dwell_s": 4,
